#!/usr/bin/env bash
# agent-up: the HOST-side launcher for agent containers (spec §4, amended 2026-10-06).
# It lives in the owner's agent-containers clone; symlink it onto your PATH if you like.
# It reads ONLY the owner's config dir, ~/.config/agent-containers/<project>/, plus its own seeds.
# It NEVER executes or reads configuration from the project folder (the agent's rw workspace).
set -euo pipefail

HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
SEEDS="$HERE/../project-template"
CFG_ROOT="${AGENT_CONTAINERS_CONFIG:-$HOME/.config/agent-containers}"

die(){ printf 'agent-up: %s\n' "$*" >&2; exit 1; }
usage(){
  cat >&2 <<'USAGE'
usage:
  agent-up init <project-dir> [--name NAME] [--image base|gis|bio]   a builder project
  agent-up init --profile research [--image base|gis|bio]           the ONE shared research container
  agent-up up <project>                  resolve secrets with `op run`, (re)create the container
                                         (research: no secrets, no `op run`)
  agent-up config <project> [ARGS...]    print the rendered compose config (no secrets needed)
  agent-up shell <project>               zsh in the container as `agent`
  agent-up pair <project>                print a one-time T3 Code pairing link (valid 10 min) and the app addresses
  agent-up rstudio <project>             print the RStudio Server address, user and password (RSTUDIO=1)
  agent-up status|stop|down <project>
  agent-up busy --all | <project>...     is R work or an agent running? (exit 1 = busy)
USAGE
  exit 2
}
normalise(){ printf '%s' "$1" | tr 'A-Z' 'a-z' | sed 's/[^a-z0-9_-]/-/g; s/^[^a-z0-9]*//'; }
conf_get(){ sed -n "s/^$2=//p" "$1" | tail -n 1; }   # $1 project.conf, $2 KEY
next_t3_port(){ # lowest port >= 3773 not used by another project's config
  local p=3773 used
  used="$(cat "$CFG_ROOT"/*/project.conf 2>/dev/null | sed -n 's/^T3_PORT=//p' | sort -u)"
  while grep -qx "$p" <<<"$used"; do p=$((p+1)); done
  printf '%s' "$p"
}

all_ports(){ # every T3_PORT and RSTUDIO_PORT in every project's config, one per line
  cat "$CFG_ROOT"/*/project.conf 2>/dev/null | sed -n 's/^\(T3_PORT\|RSTUDIO_PORT\)=//p' | sort -u
}
next_rstudio_port(){ # lowest port >= 8787 not used by any project's T3_PORT or RSTUDIO_PORT
  local p=8787 used
  used="$(all_ports)"
  while grep -qx "$p" <<<"$used"; do p=$((p+1)); done
  printf '%s' "$p"
}

cmd_init(){
  local dir="" name="" image="gis" profile="builder"
  while [ $# -gt 0 ]; do
    case "$1" in
      --name)    [ $# -ge 2 ] || usage; name="$2"; shift 2 ;;
      --image)   [ $# -ge 2 ] || usage; image="$2"; shift 2 ;;
      --profile) [ $# -ge 2 ] || usage; profile="$2"; shift 2 ;;
      -*) usage ;;
      *) [ -z "$dir" ] || usage; dir="$1"; shift ;;
    esac
  done
  case "$image" in base|gis|bio) ;; *) die "--image must be base, gis or bio (got: $image)" ;; esac
  case "$profile" in
    builder) ;;
    research) init_research "$dir" "$name" "$image"; return ;;
    *) die "--profile must be builder or research (got: $profile)" ;;
  esac
  [ -n "$dir" ] || usage
  [ -d "$dir" ] || die "project directory not found: $dir"
  dir="$(cd "$dir" && pwd -P)"
  name="$(normalise "${name:-$(basename "$dir")}")"
  [ -n "$name" ] || die "could not derive a project name from '$dir'; pass --name"
  [ "$name" != research ] || die "'research' is reserved for the shared research container; pass --name"
  local cfg="$CFG_ROOT/$name"
  { [ ! -e "$cfg" ] && [ ! -L "$cfg" ]; } || die "config already exists: $cfg (edit it there; init never overwrites)"

  local old_umask; old_umask=$(umask)
  umask 077   # config files are private from the first byte
  mkdir -p "$CFG_ROOT"; chmod 700 "$CFG_ROOT"
  # Build in a temp dir and move into place last, so a failure never leaves a half-built config.
  local tmp; tmp="$(mktemp -d "$CFG_ROOT/.init.XXXXXX")"
  trap 'rm -rf "$tmp"' EXIT
  sed "s|/spades-gis@sha256:|/spades-$image@sha256:|" "$SEEDS/config/compose.yaml" > "$tmp/compose.yaml"
  sed "s|PROJECTNAME|$name|g" "$SEEDS/config/project.env" > "$tmp/project.env"
  cp "$SEEDS/config/allowlist" "$tmp/allowlist"
  if [ "$image" = bio ]; then
    { echo; cat "$SEEDS/config/allowlist.bio-example"; } >> "$tmp/allowlist"
  fi
  cat > "$tmp/project.conf" <<CONFEOF
# Owner-maintained settings for agent-up; also compose interpolation variables (--env-file).
# KEY=VALUE, no quotes.
PROJECT=$name
PROJECT_DIR=$dir
PROFILE=$profile
IMAGE=$image
SPADES_AI_DIR=$HOME/GitHub/spades.ai
AGENT_MEMORY_DIR=$HOME/agent-memory
# Host port for this project's T3 Code server (127.0.0.1 only); unique per project.
T3_PORT=$(next_t3_port)
# T3 Connect: 0 = off, 1 = managed tunnel (T3's relay + Cloudflare; at most 3 per T3 account), publish = notifications only, connect over Tailscale (README "Phone and desktop apps").
# Opt-in; read project-template/README.md "T3 Connect (opt-in)" first.
T3_CONNECT=0
# Research exchange with the shared research container: 0 = off, 1 = on. On mounts
# RESEARCH_DIR/<project>/briefs read-write and its reports + downloads READ-ONLY at /research/
# (project-template/README.md "Research container").
RESEARCH=0
RESEARCH_DIR=$HOME/agent-research
# RStudio Server in the browser: 0 = off, 1 = on (opt-in; project-template/README.md "RStudio Server").
# Its host port (127.0.0.1 only), unique across all projects' T3_PORT and RSTUDIO_PORT.
RSTUDIO=0
RSTUDIO_PORT=$(next_rstudio_port)
CONFEOF
  ftp_seed "$image" >> "$tmp/project.conf"
  chmod 600 "$tmp/compose.yaml" "$tmp/project.env" "$tmp/allowlist" "$tmp/project.conf"
  chmod 700 "$tmp"
  mv -T "$tmp" "$cfg"
  umask "$old_umask"
  trap - EXIT

  local mem="$HOME/agent-memory"
  if [ ! -d "$mem" ]; then
    mkdir -p "$mem" && git -C "$mem" init -q
    echo "agent-up: created the shared agent memory repo $mem (spec §13.2)"
  fi

  local f rel parts part cur linked
  while IFS= read -r -d '' f; do
    rel="${f#"$SEEDS/repo/"}"
    # Never write through a symlink: the project dir is agent-writable.
    linked=0; cur="$dir"
    IFS=/ read -r -a parts <<<"$(dirname "$rel")"
    for part in "${parts[@]}"; do
      [ "$part" = . ] && continue
      cur="$cur/$part"
      if [ -L "$cur" ]; then linked=1; break; fi
      [ -e "$cur" ] || break
    done
    if [ "$linked" = 1 ]; then
      echo "agent-up: skipped $rel: a symlink in its path (not followed)"
    elif [ -e "$dir/$rel" ] || [ -L "$dir/$rel" ]; then
      echo "agent-up: kept the project's existing $rel"
    else
      mkdir -p "$dir/$(dirname "$rel")"; cp "$f" "$dir/$rel"
      echo "agent-up: added $rel to the project (review and commit it)"
    fi
  done < <(find "$SEEDS/repo" -type f -print0 | sort -z)

  cat <<FINALEOF
agent-up: created $cfg
Next (docs/runbooks/new-project.md):
  1. set the image digest in $cfg/compose.yaml (from agent-containers/digests.md)
  2. vault agent-$name + service account + scoped GitHub token (docs/runbooks/1password-project-vault.md)
  3. add the project's domains to $cfg/allowlist
  4. replace @OWNER in $dir/.github/CODEOWNERS
  5. agent-up up $name
FINALEOF
}

init_research(){ # $1 dir (must be empty), $2 --name (must be empty or research), $3 image
  [ -z "$1" ] || die "--profile research takes no project directory: the research container mounts no project"
  [ -z "$2" ] || [ "$(normalise "$2")" = research ] || die "the research container is always named 'research'"
  local name=research image="$3" cfg="$CFG_ROOT/research" rd="$HOME/agent-research"
  { [ ! -e "$cfg" ] && [ ! -L "$cfg" ]; } || die "config already exists: $cfg (edit it there; init never overwrites)"
  local old_umask; old_umask=$(umask)
  umask 077
  mkdir -p "$CFG_ROOT"; chmod 700 "$CFG_ROOT"
  local tmp; tmp="$(mktemp -d "$CFG_ROOT/.init.XXXXXX")"
  trap 'rm -rf "$tmp"' EXIT
  sed "s|/spades-gis@sha256:|/spades-$image@sha256:|" "$SEEDS/config/compose.research.yaml" > "$tmp/compose.yaml"
  cat > "$tmp/project.conf" <<CONFEOF
# Owner-maintained settings for agent-up; also compose interpolation variables (--env-file).
# KEY=VALUE, no quotes. The SHARED research container (spec §2.1): open public egress, no secrets,
# no project folder. It sees RESEARCH_DIR/<project>/ for every project subfolder there.
PROJECT=$name
PROFILE=research
IMAGE=$image
# The research exchange root on the host (not inside any project, config or agent-containers clone).
RESEARCH_DIR=$rd
# Host port for this container's T3 Code server (127.0.0.1 only); unique per project.
T3_PORT=$(next_t3_port)
# T3 Connect: 0 = off, 1 = managed tunnel (T3's relay + Cloudflare; at most 3 per T3 account), publish = notifications only, connect over Tailscale (README "Phone and desktop apps").
T3_CONNECT=0
CONFEOF
  chmod 600 "$tmp/compose.yaml" "$tmp/project.conf"
  chmod 700 "$tmp"
  mv -T "$tmp" "$cfg"
  umask "$old_umask"
  trap - EXIT
  if [ ! -d "$rd" ]; then
    mkdir -p "$rd" && echo "agent-up: created the research exchange $rd"
  fi
  cat <<FINALEOF
agent-up: created $cfg (the shared research container: no secrets, no 1Password vault)
Next (project-template/README.md "Research container"):
  1. set the image digest in $cfg/compose.yaml (the spades-$image row of agent-containers/digests.md)
  2. set RESEARCH=1 in each builder project's project.conf that should use it
  3. agent-up up research; then log in once: agent-up shell research -> claude, codex login --device-auth
  4. agent-up pair research (T3 Code; its project is /research/_general, which persists; create T3 projects only under /research/_general or /research/<project>)
FINALEOF
}

cfg_dir(){ # $1 project -> its config dir (must exist)
  local p; p="$(normalise "$1")"
  [ -n "$p" ] || die "empty project name"
  [ -d "$CFG_ROOT/$p" ] || die "no config for '$p' in $CFG_ROOT (run: agent-up init <project-dir>)"
  printf '%s' "$CFG_ROOT/$p"
}
profile(){ conf_get "$1/project.conf" PROFILE; }   # $1 config dir
check_files(){
  local f cfgname proj prof img files=(compose.yaml project.env allowlist project.conf)
  [ -f "$1/project.conf" ] || die "missing $1/project.conf (re-create it from agent-containers/project-template/config)"
  prof="$(profile "$1")"
  case "$prof" in
    builder) ;;
    research) files=(compose.yaml project.conf) ;;   # no secrets, no allowlist: nothing else is used
    *) die "PROFILE=$prof in $1/project.conf: must be builder or research" ;;
  esac
  for f in "${files[@]}"; do
    [ -f "$1/$f" ] || die "missing $1/$f (re-create it from agent-containers/project-template/config)"
  done
  cfgname="$(basename "$1")"
  proj="$(conf_get "$1/project.conf" PROJECT)"
  [ "$proj" = "$cfgname" ] || die "PROJECT in $1/project.conf ($proj) must equal the config dir name ($cfgname)"
  if [ "$prof" = research ] && [ "$proj" != research ]; then
    die "PROFILE=research in $1/project.conf: only the shared research container (agent-up init --profile research) uses it"
  fi
  if [ "$prof" = builder ] && [ "$proj" = research ]; then
    die "the project name 'research' is reserved for the shared research container"
  fi
  img="$(conf_get "$1/project.conf" IMAGE)"
  case "$img" in base|gis|bio) ;; *) die "IMAGE=$img in $1/project.conf: must be base, gis or bio" ;; esac
}
check_t3_port(){ # only up and pair need it: stop/down must work on a config that predates T3
  local port; port="$(conf_get "$1/project.conf" T3_PORT)"
  [[ $port =~ ^[0-9]+$ ]] && [ "$port" -ge 1024 ] && [ "$port" -le 65535 ] \
    || die "T3_PORT='$port' in $1/project.conf: set a free port 1024-65535, unique per project (e.g. T3_PORT=$(next_t3_port))"
  local other
  for other in "$CFG_ROOT"/*/project.conf; do
    [ -f "$other" ] && [ "$other" != "$1/project.conf" ] || continue
    [ "$(conf_get "$other" T3_PORT)" != "$port" ] \
      || die "T3_PORT=$port in $1/project.conf is also used by $(basename "$(dirname "$other")"): pick another (free: $(next_t3_port))"
  done
}
t3_connect(){ # $1 config dir -> the T3_CONNECT value as written; absent = 0 (configs that predate it)
  local v; v="$(conf_get "$1/project.conf" T3_CONNECT)"; printf '%s' "${v:-0}"
}
check_t3_connect(){ # only up and config: stop/down/status must work whatever the value
  case "$(t3_connect "$1")" in
    0|1|publish) ;;
    *) die "T3_CONNECT='$(t3_connect "$1")' in $1/project.conf: must be 0 (off), 1 (managed tunnel) or publish (publish-only)" ;;
  esac
}
t3_connect_on(){ # $1 config dir: true for 1 or publish (the firewall switch is written)
  case "$(t3_connect "$1")" in 1|publish) return 0 ;; *) return 1 ;; esac
}
research_on(){ # $1 config dir: a builder with exactly RESEARCH=1 (stop/down never validate: anything else is off)
  [ "$(profile "$1")" = builder ] && [ "$(conf_get "$1/project.conf" RESEARCH)" = 1 ]
}
research_dir(){ # $1 config dir -> RESEARCH_DIR as written; absent = ~/agent-research
  local v; v="$(conf_get "$1/project.conf" RESEARCH_DIR)"; printf '%s' "${v:-$HOME/agent-research}"
}
check_research(){ # only up and config: stop/down/status must work whatever the values
  local v; v="$(conf_get "$1/project.conf" RESEARCH)"
  if [ "$(profile "$1")" = builder ]; then
    case "${v:-0}" in
      0|1) ;;
      *) die "RESEARCH='$v' in $1/project.conf: must be 0 (off) or 1 (on)" ;;
    esac
  fi
  if [ "$(profile "$1")" = research ] || research_on "$1"; then
    [[ $(research_dir "$1") == /* ]] || die "RESEARCH_DIR='$(research_dir "$1")' in $1/project.conf: must be an absolute path"
  fi
}
check_research_env(){ # the research container holds NO secrets: a project.env, if present, defines nothing
  local f="$1/project.env" bad
  [ -e "$f" ] || return 0
  bad="$(grep -nEv '^[[:space:]]*(#|$)' "$f" | cut -d: -f1 | paste -sd, - || true)"
  [ -z "$bad" ] || die "$f: the research container holds no secrets, so it may define nothing (line number(s): $bad, values not shown). Delete the file."
}
exchange_dirs(){ # $1 research root, $2 project: create <project>/{briefs,reports,downloads}, never through a symlink
  local d
  for d in "$1/$2" "$1/$2/briefs" "$1/$2/reports" "$1/$2/downloads"; do
    [ ! -L "$d" ] || die "$d is a symlink: the research exchange folders must be real folders"
    if [ ! -d "$d" ]; then
      mkdir "$d" || die "could not create $d"
      echo "agent-up: created $d"
    fi
  done
}
general_dir(){ # $1 research root: create <root>/_general (research not tied to a project), never through a symlink
  [ ! -L "$1/_general" ] || die "$1/_general is a symlink: it must be a real folder"
  if [ ! -d "$1/_general" ]; then
    mkdir "$1/_general" || die "could not create $1/_general"
    echo "agent-up: created $1/_general"
  fi
}
exchange_projects(){ # $1 research root -> the complete project subfolders, one per line
  local d p
  for d in "$1"/*/; do
    d="${d%/}"; p="${d##*/}"
    [ "$p" != _general ] || continue   # not a project: its own mount (general_dir)
    [ -d "$d" ] && [ ! -L "$d" ] || continue
    if [[ ! $p =~ ^[a-z0-9][a-z0-9_-]*$ ]]; then echo "agent-up: research: skipped '$d' (not a project name)" >&2; continue; fi
    if [ ! -d "$d/briefs" ] || [ ! -d "$d/reports" ] || [ ! -d "$d/downloads" ] \
       || [ -L "$d/briefs" ] || [ -L "$d/reports" ] || [ -L "$d/downloads" ]; then
      echo "agent-up: research: skipped '$d' (needs real briefs/, reports/ and downloads/ folders)" >&2; continue
    fi
    printf '%s\n' "$p"
  done
}
make_exchange(){ # up only: the research root and this config's project subfolders
  local rd other
  if [ "$(profile "$1")" = research ]; then
    rd="$(research_dir "$1")"; mkdir -p "$rd"
    general_dir "$rd"
    # every builder that opted in (and shares this root), so the order of `up`s does not matter
    for other in "$CFG_ROOT"/*/project.conf; do
      [ -f "$other" ] && research_on "$(dirname "$other")" || continue
      [ "$(research_dir "$(dirname "$other")")" = "$rd" ] || continue
      exchange_dirs "$rd" "$(basename "$(dirname "$other")")"
    done
  elif research_on "$1"; then
    rd="$(research_dir "$1")"; mkdir -p "$rd"
    exchange_dirs "$rd" "$(basename "$1")"
  fi
}
check_research_overlaps(){ # every research root (writable by the research container) vs everything an agent must not reach
  local rds=() prot=() other od k src rd what path clone rootreal
  clone="$(cd "$HERE/.." && pwd -P)"; rootreal="$(cd "$CFG_ROOT" && pwd -P)"
  if [ "$(profile "$1")" = research ] || research_on "$1"; then rds+=("$(research_dir "$1")"); fi
  for other in "$CFG_ROOT"/*/project.conf; do
    [ -f "$other" ] || continue
    od="$(dirname "$other")"
    if [ "$(profile "$od")" = research ]; then rds+=("$(research_dir "$od")"); fi
  done
  [ "${#rds[@]}" -gt 0 ] || return 0
  prot=("the config root|$rootreal" "the agent-containers clone|$clone")
  for other in "$CFG_ROOT"/*/project.conf; do
    [ -f "$other" ] || continue
    od="$(dirname "$other")"
    [ "$(profile "$od")" = builder ] || continue
    for k in PROJECT_DIR SPADES_AI_DIR AGENT_MEMORY_DIR; do
      src="$(conf_get "$other" "$k")"
      [ -n "$src" ] && [ -d "$src" ] || continue
      prot+=("$k of project $(basename "$od")|$(cd "$src" && pwd -P)")
    done
  done
  for rd in "${rds[@]}"; do
    [ -d "$rd" ] || continue
    rd="$(cd "$rd" && pwd -P)"
    for what in "${prot[@]}"; do
      path="${what#*|}"; what="${what%%|*}"
      ! overlaps "$rd" "$path" || die "RESEARCH_DIR ($rd) overlaps $what ($path): the research container could write into it, or an agent could reach the exchange. Use a separate folder (default ~/agent-research)."
    done
  done
}
rstudio(){ # $1 config dir -> the RSTUDIO value as written; absent = 0 (configs that predate it)
  local v; v="$(conf_get "$1/project.conf" RSTUDIO)"; printf '%s' "${v:-0}"
}
rstudio_on(){ # RSTUDIO=1 with a well-formed RSTUDIO_PORT. stop/down render with this and never refuse:
  # an incomplete config renders RStudio off for them (up/config/rstudio refuse it instead).
  # Builders only: the research container never runs RStudio (spec §13.3).
  local port; port="$(conf_get "$1/project.conf" RSTUDIO_PORT)"
  [ "$(profile "$1")" = builder ] && [ "$(rstudio "$1")" = 1 ] && [[ $port =~ ^[0-9]+$ ]] && [ "$port" -ge 1024 ] && [ "$port" -le 65535 ]
}
check_rstudio_port(){ # $1 config dir: a free port, used by no other T3_PORT/RSTUDIO_PORT (nor this T3_PORT)
  local port other k; port="$(conf_get "$1/project.conf" RSTUDIO_PORT)"
  [[ $port =~ ^[0-9]+$ ]] && [ "$port" -ge 1024 ] && [ "$port" -le 65535 ] \
    || die "RSTUDIO_PORT='$port' in $1/project.conf: set a free port 1024-65535, unique across projects (e.g. RSTUDIO_PORT=$(next_rstudio_port))"
  [ "$(conf_get "$1/project.conf" T3_PORT)" != "$port" ] || die "RSTUDIO_PORT=$port in $1/project.conf equals its T3_PORT: pick another (free: $(next_rstudio_port))"
  for other in "$CFG_ROOT"/*/project.conf; do
    [ -f "$other" ] && [ "$other" != "$1/project.conf" ] || continue
    for k in T3_PORT RSTUDIO_PORT; do
      [ "$(conf_get "$other" "$k")" != "$port" ] \
        || die "RSTUDIO_PORT=$port in $1/project.conf is also used by $(basename "$(dirname "$other")") ($k): pick another (free: $(next_rstudio_port))"
    done
  done
}
check_rstudio(){ # only up, config and rstudio: stop/down/status must work whatever the values
  if [ "$(profile "$1")" = research ]; then
    [ "$(rstudio "$1")" = 0 ] || die "RSTUDIO='$(rstudio "$1")' in $1/project.conf: RStudio Server is for builder projects only, not the research container"
    return 0
  fi
  case "$(rstudio "$1")" in
    0) ;;
    1) check_rstudio_port "$1" ;;
    *) die "RSTUDIO='$(rstudio "$1")' in $1/project.conf: must be 0 (off) or 1 (on)" ;;
  esac
}
ftp_seed(){ # $1 image -> the FTP_HOSTS block of a new builder's project.conf: always commented out (off)
  echo "# FTP uploads: space-separated bare domains that get plain FTP (tcp 21, CLEARTEXT) + the kernel's"
  echo "# FTP conntrack helper; empty or absent = off. Builders only. Read project-template/README.md"
  echo "# \"FTP uploads (sequence archives)\" first (the host kernel needs nf_conntrack_ftp)."
  if [ "$1" = bio ]; then
    echo "# Sequence archives: ENA Webin webin2.ebi.ac.uk, NCBI SRA ftp-private.ncbi.nlm.nih.gov (list only what you use)."
    echo "#FTP_HOSTS=webin2.ebi.ac.uk"
  else
    echo "#FTP_HOSTS="
  fi
}
ftp_hosts(){ # $1 config dir -> FTP_HOSTS as written, minus ONE pair of surrounding quotes; absent = empty (off)
  local v; v="$(conf_get "$1/project.conf" FTP_HOSTS)"
  case "$v" in \"*\") v="${v#\"}"; v="${v%\"}" ;; \'*\') v="${v#\'}"; v="${v%\'}" ;; esac
  printf '%s' "$v"
}
FTP_DOMAIN_RE='^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$'   # = init-firewall.sh's DOMAIN_RE (the allowlist's)
ftp_bad_token(){ # $1 config dir -> the first FTP_HOSTS token that is not a bare domain (nothing: all fine)
  local t; local -a toks
  read -r -a toks <<<"$(ftp_hosts "$1")" || true
  for t in "${toks[@]}"; do [[ $t =~ $FTP_DOMAIN_RE ]] || { printf '%s' "$t"; return 0; }; done
}
ftp_list(){ # $1 config dir -> the FTP_HOSTS domains, lower-cased, sorted, unique, one per line
  local -a toks
  read -r -a toks <<<"$(ftp_hosts "$1")" || true
  [ "${#toks[@]}" -gt 0 ] || return 0
  printf '%s\n' "${toks[@]}" | tr 'A-Z' 'a-z' | sort -u
}
ftp_on(){ # a builder with a non-empty FTP_HOSTS of valid domains. stop/down render with this and never
  # refuse: an invalid list renders FTP off for them (up/config refuse it instead).
  [ "$(profile "$1")" = builder ] && [ -n "$(ftp_list "$1")" ] && [ -z "$(ftp_bad_token "$1")" ]
}
check_ftp(){ # only up and config: stop/down/status must work whatever the value
  local bad
  if [ "$(profile "$1")" = research ]; then
    [ -z "$(ftp_list "$1")" ] || die "FTP_HOSTS in $1/project.conf: FTP uploads are for builder projects only; the research container's egress is already open on every port"
    return 0
  fi
  bad="$(ftp_bad_token "$1")"
  [ -z "$bad" ] || die "FTP_HOSTS in $1/project.conf: '$bad' is not a bare domain (want space-separated names like webin2.ebi.ac.uk: no ftp://, port, path or wildcard)"
}
t3_host(){ printf '%s.localhost' "$(printf '%s' "$1" | tr '_' '-')"; } # per-project browser origin (cookies are per host, not per port)
rstudio_host(){ printf 'rstudio-%s' "$(t3_host "$1")"; } # its own origin: not T3's, not another project's
tailscale_host(){ # the shared TAILSCALE_HOST from $CFG_ROOT/agent-up.conf: validated host or nothing (unset)
  local f="$CFG_ROOT/agent-up.conf" v=""
  [ ! -f "$f" ] || v="$(conf_get "$f" TAILSCALE_HOST)"
  [ -n "$v" ] || return 0
  [[ $v =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$ ]] \
    || die "TAILSCALE_HOST='$v' in $f: must be a bare host name like machine.tailnet.ts.net"
  printf '%s' "$v"
}
ts_port_raw(){ # $1 config dir -> override or the formula, unvalidated (empty if neither is computable)
  local v t; v="$(conf_get "$1/project.conf" TAILSCALE_HTTPS_PORT)"
  if [ -n "$v" ]; then # decimal, so 08442 equals 8442 (and 08 is no octal error)
    if [[ $v =~ ^[0-9]{1,9}$ ]]; then printf '%s' "$((10#$v))"; else printf '%s' "$v"; fi
    return 0
  fi
  t="$(conf_get "$1/project.conf" T3_PORT)"
  [[ $t =~ ^[0-9]{1,9}$ ]] && printf '%s' "$((8443 + 10#$t - 3774))" || true
}
ts_port(){ # $1 config dir -> the Tailscale Serve HTTPS port, validated 1-65535
  local v; v="$(ts_port_raw "$1")"
  [[ $v =~ ^[0-9]+$ ]] && [ "$v" -ge 1 ] && [ "$v" -le 65535 ] \
    || die "TAILSCALE_HTTPS_PORT='$v' in $1/project.conf: must be a port 1-65535"
  printf '%s' "$v"
}
check_ts_port(){ # only up and pair: stop/down/status must work whatever the values
  local port other; port="$(ts_port "$1")"
  for other in "$CFG_ROOT"/*/project.conf; do
    [ -f "$other" ] && [ "$other" != "$1/project.conf" ] || continue
    [ "$(ts_port_raw "$(dirname "$other")")" != "$port" ] \
      || die "TAILSCALE_HTTPS_PORT=$port in $1/project.conf is also used by $(basename "$(dirname "$other")"): set TAILSCALE_HTTPS_PORT to a free port in $1/project.conf"
  done
  tailscale_host >/dev/null
}
ts_url(){ # $1 config dir -> the phone address (placeholder host when TAILSCALE_HOST is unset)
  local h port; h="$(tailscale_host)"; port="$(ts_port "$1")"
  if [ "$port" = 443 ]; then printf 'https://%s' "${h:-<tailnet-host>}"; else printf 'https://%s:%s' "${h:-<tailnet-host>}" "$port"; fi
}
check_digest(){
  grep -Eq '^[[:space:]]*image:[[:space:]]*[^[:space:]]+@sha256:[0-9a-f]{64}[[:space:]]*$' "$1" \
    || die "$1: the image is not pinned to a real digest (@sha256:<64 hex>). Copy one from agent-containers/digests.md."
}
check_project_env(){ # op:// references only; never echo a line (it could hold a pasted secret)
  local bad reserved
  reserved="$(grep -nE '^[[:space:]]*(PROJECT|PROJECT_DIR|PROFILE|IMAGE|SPADES_AI_DIR|AGENT_MEMORY_DIR|T3_PORT|T3_CONNECT|TAILSCALE_HTTPS_PORT|TAILSCALE_HOST|RESEARCH|RSTUDIO|FTP_HOSTS|PATH|HOME|COMPOSE|(COMPOSE|DOCKER|OP|TUNNEL|RESEARCH|RS|RSTUDIO)_[A-Za-z0-9_]*)=' "$1" | sed 's/^\([0-9]*\):[[:space:]]*\([A-Za-z0-9_]*\)=.*/line \1: \2/' | paste -sd, - || true)"
  [ -z "$reserved" ] || die "$1 uses reserved key name(s) that would override compose or the launcher ($reserved); rename them"
  bad="$(grep -nEv '^[[:space:]]*(#|$)' "$1" | grep -Ev '^[0-9]+:[A-Za-z_][A-Za-z0-9_]*=op://[^[:space:]]+$' | cut -d: -f1 | paste -sd, - || true)"
  [ -z "$bad" ] || die "$1 may hold only KEY=op://... references; offending line number(s): $bad (values not shown)"
}
under(){ # is resolved path $1 equal to or inside resolved path $2? QUOTED prefix: path characters never glob; "/" holds everything
  [ "$2" = / ] && return 0
  [ "$1" = "$2" ] && return 0
  case "$1" in "$2"/*) return 0 ;; esac
  return 1
}
overlaps(){ under "$1" "$2" || under "$2" "$1"; } # both resolved with pwd -P
check_mounts(){ # every rw bind source exists and neither contains, equals nor sits inside the config root or this clone
  local key src what path clone rootreal
  clone="$(cd "$HERE/.." && pwd -P)"
  rootreal="$(cd "$CFG_ROOT" && pwd -P)"
  [ "$(profile "$1")" = builder ] || return 0   # research: no project, spades.ai or memory (RESEARCH_DIR: check_research_overlaps)
  for key in PROJECT_DIR SPADES_AI_DIR AGENT_MEMORY_DIR; do
    src="$(conf_get "$1/project.conf" "$key")"
    [ -n "$src" ] || die "$key is not set in $1/project.conf"
    [ -d "$src" ] || die "$key directory not found: $src (create it, or fix $key in $1/project.conf)"
    src="$(cd "$src" && pwd -P)"
    # the config root contains every project's config, including this one's dir and its .generated/
    for what in "the config root|$rootreal" "the agent-containers clone (the launcher and its seeds)|$clone"; do
      path="${what#*|}"; what="${what%%|*}"
      ! overlaps "$src" "$path" || die "$key ($src) overlaps $what ($path): the agent could rewrite what the host runs. Use a separate agent-only clone."
    done
  done
}
write_passthrough(){ # container env NAMES from project.env; values never touch disk
  local keys k out="$1/.generated/env-passthrough.yaml"
  keys=""   # research: never any (check_research_env refuses a non-empty project.env too)
  [ "$(profile "$1")" = research ] || keys="$(sed -n 's/^\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' "$1/project.env" | sort -u)"
  mkdir -p "$1/.generated"; chmod 700 "$1/.generated"
  {
    echo "# GENERATED by agent-up from the key NAMES in project.env. Values are never written. Do not edit."
    echo "services:"
    echo "  agent:"
    if [ -n "$keys" ]; then
      echo "    environment:"
      while IFS= read -r k; do echo "      - $k"; done <<<"$keys"
    else
      echo "    environment: []"
    fi
  } > "$out"
}
write_t3_connect(){ # T3_CONNECT=1|publish: a read-only switch file for the firewall (+ cloudflared's env for 1). 0: nothing.
  local out="$1/.generated/t3-connect.yaml" flag="$1/.generated/t3-connect"
  mkdir -p "$1/.generated"; chmod 700 "$1/.generated"
  {
    echo "# GENERATED by agent-up from T3_CONNECT in project.conf. Do not edit."
    echo "services:"
    if t3_connect_on "$1"; then
      echo "  agent:"
      echo "    environment:"
      echo "      T3_CONNECT: \"$(t3_connect "$1")\"      # informational: the firewall reads ONLY the mounted file"
      [ "$(t3_connect "$1")" = 1 ] && echo "      TUNNEL_EDGE_IP_VERSION: \"4\"     # cloudflared: IPv4 edge only (IPv6 egress is denied)"
      echo "    volumes:"
      echo "      - type: bind                  # read by the root firewall at start; the agent cannot change it"
      echo "        source: ./.generated/t3-connect"
      echo "        target: /etc/firewall/t3-connect"
      echo "        read_only: true"
      echo "        bind: {create_host_path: false}"
    else
      echo "  agent: {}"
    fi
  } > "$out"
  # Only an exact, validated 1 or publish opens anything; any other value (stop/down do not validate) is off.
  if t3_connect_on "$1"; then echo "T3_CONNECT=$(t3_connect "$1")" > "$flag"; else rm -f "$flag"; fi
}
yaml_str(){ # a double-quoted YAML scalar for compose: \ and " escaped, $ doubled (never interpolated)
  local v="$1"; v="${v//\\/\\\\}"; v="${v//\"/\\\"}"; v="${v//\$/\$\$}"; printf '"%s"' "$v"
}
bind_yaml(){ # $1 source, $2 target, $3 ro|rw
  echo "      - type: bind"
  echo "        source: $(yaml_str "$1")"
  echo "        target: $(yaml_str "$2")"
  if [ "$3" = ro ]; then echo "        read_only: true"; fi
  echo "        bind: {create_host_path: false}"
}
write_research(){ # the research profile's switch + instructions + exchange; a builder's RESEARCH=1 mounts; else nothing
  local g="$1/.generated" rd p name; name="$(basename "$1")"
  mkdir -p "$g"; chmod 700 "$g"
  rd="$(research_dir "$1")"; if [ -d "$rd" ]; then rd="$(cd "$rd" && pwd -P)"; fi
  {
    echo "# GENERATED by agent-up from PROFILE, RESEARCH and RESEARCH_DIR in project.conf. Do not edit."
    echo "services:"
    if [ "$(profile "$1")" = research ]; then
      echo "  agent:"
      echo "    working_dir: /research/_general        # persistent; overrides the owner's compose.yaml"
      echo "    environment:"
      echo "      T3_PROJECT_DIR: /research/_general   # T3 Code's default project; overrides compose.yaml"
      echo "    volumes:"
      echo "      # read by the root firewall at start (open public egress); the agent cannot change it"
      bind_yaml ./.generated/profile /etc/firewall/profile ro
      echo "      # the owner's instructions: Claude Code's managed CLAUDE.md, and Codex's global AGENTS.md"
      bind_yaml ./.generated/agent-instructions.md /etc/claude-code/CLAUDE.md ro
      bind_yaml ./.generated/agent-instructions.md /home/agent/.codex/AGENTS.md ro
      echo "      # the research exchange: one set per project subfolder of RESEARCH_DIR ($rd), plus _general"
      if [ -d "$rd" ]; then
        if [ -d "$rd/_general" ] && [ ! -L "$rd/_general" ]; then
          bind_yaml "$rd/_general" /research/_general rw
        fi
        while IFS= read -r p; do
          [ -n "$p" ] || continue
          bind_yaml "$rd/$p/briefs" "/research/$p/briefs" ro
          bind_yaml "$rd/$p/reports" "/research/$p/reports" rw
          bind_yaml "$rd/$p/downloads" "/research/$p/downloads" rw
        done < <(exchange_projects "$rd")
      fi
    elif research_on "$1"; then
      echo "  agent:"
      echo "    volumes:"
      echo "      # the owner's instructions (reports and downloads are untrusted data), read-only"
      bind_yaml ./.generated/agent-instructions.md /etc/claude-code/CLAUDE.md ro
      bind_yaml ./.generated/agent-instructions.md /home/agent/.codex/AGENTS.md ro
      echo "      # the research exchange: briefs out (rw); reports and downloads in, READ-ONLY (untrusted)"
      bind_yaml "$rd/$name/briefs" /research/briefs rw
      bind_yaml "$rd/$name/reports" /research/reports ro
      bind_yaml "$rd/$name/downloads" /research/downloads ro
    else
      echo "  agent: {}"
    fi
  } > "$g/research.yaml"
  if [ "$(profile "$1")" = research ]; then echo "PROFILE=research" > "$g/profile"; else rm -f "$g/profile"; fi
  if [ "$(profile "$1")" = research ]; then
    cp "$SEEDS/instructions/research.md" "$g/agent-instructions.md"; chmod 644 "$g/agent-instructions.md"
  elif research_on "$1"; then
    cp "$SEEDS/instructions/builder-research.md" "$g/agent-instructions.md"; chmod 644 "$g/agent-instructions.md"
  else
    rm -f "$g/agent-instructions.md"
  fi
}
write_rstudio(){ # RSTUDIO=1 (rstudio_on): port, volume, read-only switch + password. Otherwise: nothing.
  local out="$1/.generated/rstudio.yaml" flag="$1/.generated/rstudio" pw="$1/.generated/rstudio-password"
  mkdir -p "$1/.generated"; chmod 700 "$1/.generated"
  if rstudio_on "$1"; then
    # One random password per project, kept across `up` (delete the file to rotate it). 128 bits.
    if [ ! -e "$pw" ]; then
      ( umask 077; od -An -tx1 -N16 /dev/urandom | tr -d ' \n' > "$pw.tmp" && mv "$pw.tmp" "$pw" ) \
        || die "could not write $pw"
    fi
    chmod 600 "$pw"
    [ "$(wc -l < "$pw")" -le 1 ] && [[ "$(cat "$pw")" =~ ^[[:graph:]]{16,}$ ]] \
      || die "$pw must be one line of 16+ printable characters, no spaces (delete it to generate a new one)"
  fi
  {
    echo "# GENERATED by agent-up from RSTUDIO in project.conf. Do not edit."
    echo "services:"
    if rstudio_on "$1"; then
      echo "  agent:"
      echo "    ports: [\"127.0.0.1:\${RSTUDIO_PORT:?set RSTUDIO_PORT in project.conf}:8787\"]   # the HOST's loopback only"
      echo "    volumes:"
      echo "      - rstudio:/home/agent/.local/share/rstudio   # RStudio state (open files, history, prefs, logs)"
      echo "      - type: bind                  # read by the root firewall at start; the agent cannot change it"
      echo "        source: ./.generated/rstudio"
      echo "        target: /etc/firewall/rstudio"
      echo "        read_only: true"
      echo "        bind: {create_host_path: false}"
      echo "      - type: bind                  # the sign-in password (rstudio-auth reads it); never an env var"
      echo "        source: ./.generated/rstudio-password"
      echo "        target: /run/secrets/rstudio-password"
      echo "        read_only: true"
      echo "        bind: {create_host_path: false}"
      echo "volumes:"
      echo "  rstudio:"
      echo "    name: rstudio-\${PROJECT}"
    else
      echo "  agent: {}"
    fi
  } > "$out"
  # Only an exact, validated 1 opens anything; any other value (stop/down do not validate) is off.
  if rstudio_on "$1"; then echo "RSTUDIO=1" > "$flag"; else rm -f "$flag"; fi
}
write_ftp(){ # FTP_HOSTS set (ftp_on): the host list, mounted read-only for the firewall. Otherwise: nothing.
  # A file, never an environment variable: sudo resets the environment, and the agent controls its own.
  local out="$1/.generated/ftp.yaml" list="$1/.generated/ftp-hosts"
  mkdir -p "$1/.generated"; chmod 700 "$1/.generated"
  {
    echo "# GENERATED by agent-up from FTP_HOSTS in project.conf. Do not edit."
    echo "services:"
    if ftp_on "$1"; then
      echo "  agent:"
      echo "    volumes:"
      echo "      - type: bind                  # read by the root firewall at start; the agent cannot change it"
      echo "        source: ./.generated/ftp-hosts"
      echo "        target: /etc/firewall/ftp-hosts"
      echo "        read_only: true"
      echo "        bind: {create_host_path: false}"
    else
      echo "  agent: {}"
    fi
  } > "$out"
  # Only a validated, non-empty list opens anything; any other value (stop/down do not validate) is off.
  if ftp_on "$1"; then
    ( umask 077; ftp_list "$1" > "$list.tmp" && mv "$list.tmp" "$list" ) || die "could not write $list"
    chmod 600 "$list"
  else
    rm -f "$list"
  fi
}
container_hostname(){ # $1 project -> a valid hostname: _ -> -, no trailing hyphen, at most 63 characters
  local h; h="$(printf '%s' "$1" | tr '_' '-' | cut -c1-63)"; h="${h%"${h##*[!-]}"}"; printf '%s' "${h:-agent}"
}
write_hostname(){ # always: a readable hostname instead of the container ID (T3 names its environment by it)
  mkdir -p "$1/.generated"; chmod 700 "$1/.generated"
  {
    echo "# GENERATED by agent-up from the project name. Do not edit."
    echo "services:"
    echo "  agent:"
    echo "    hostname: $(container_hostname "$(basename "$1")")"
  } > "$1/.generated/hostname.yaml"
}
compose_cmd(){ # sets COMPOSE for config dir $1
  COMPOSE=(docker compose --env-file "$1/project.conf" -f "$1/compose.yaml" -f "$1/.generated/env-passthrough.yaml"
           -f "$1/.generated/t3-connect.yaml" -f "$1/.generated/research.yaml" -f "$1/.generated/rstudio.yaml" -f "$1/.generated/ftp.yaml" -f "$1/.generated/hostname.yaml"
           --project-directory "$1" -p "$(basename "$1")")
}
prepare(){ check_files "$1"; write_passthrough "$1"; write_t3_connect "$1"; write_research "$1"; write_rstudio "$1"; write_ftp "$1"; write_hostname "$1"; compose_cmd "$1"; }

cmd_up(){
  [ $# -eq 1 ] || usage
  local cfg name; cfg="$(cfg_dir "$1")"; name="$(basename "$cfg")"
  check_files "$cfg"
  check_t3_port "$cfg"
  check_t3_connect "$cfg"
  check_ts_port "$cfg"
  check_research "$cfg"
  check_rstudio "$cfg"
  check_ftp "$cfg"
  check_digest "$cfg/compose.yaml"
  if [ "$(profile "$cfg")" = research ]; then check_research_env "$cfg"; else check_project_env "$cfg/project.env"; fi
  check_mounts "$cfg"
  if [ "$(profile "$cfg")" = research ] || research_on "$cfg"; then mkdir -p "$(research_dir "$cfg")"; fi
  check_research_overlaps "$cfg"   # BEFORE any project subfolder is created
  if [ "$(profile "$cfg")" = research ]; then
    make_exchange "$cfg"
    prepare "$cfg"
    # No secrets at all: no `op run`, and not even the owner's service-account token in compose's environment.
    env -u OP_SERVICE_ACCOUNT_TOKEN "${COMPOSE[@]}" up -d --force-recreate
    echo "agent-up: '$name' running (research: open public egress, no secrets). Shell: agent-up shell $name"
    echo "agent-up: research projects: $(exchange_projects "$(research_dir "$cfg")" 2>/dev/null | paste -sd' ' - || true)"
  else
    [ -n "${OP_SERVICE_ACCOUNT_TOKEN:-}" ] || die "OP_SERVICE_ACCOUNT_TOKEN is not set for this project (docs/runbooks/1password-project-vault.md)"
    make_exchange "$cfg"
    prepare "$cfg"
    local v
    for v in require-cache-shared npm-cache-shared; do
      docker volume inspect "$v" >/dev/null 2>&1 || docker volume create "$v" >/dev/null
    done
    op run --env-file "$cfg/project.env" -- "${COMPOSE[@]}" up -d --force-recreate
    if research_on "$cfg"; then
      echo "agent-up: research exchange ON: $(research_dir "$cfg")/$name (briefs rw; reports + downloads read-only, at /research)"
      if [ -f "$CFG_ROOT/research/project.conf" ] && [ "$(research_dir "$CFG_ROOT/research")" != "$(research_dir "$cfg")" ]; then
        echo "agent-up: WARNING: the research container uses RESEARCH_DIR=$(research_dir "$CFG_ROOT/research"), not $(research_dir "$cfg"): it will not see this project"
      else
        echo "agent-up: (a new project folder reaches the research container at its next: agent-up up research)"
      fi
    fi
  fi
  echo "agent-up: '$name' running. Attach: agent-up shell $name, or VS Code: Dev Containers: Attach to Running Container... -> ${name}-agent-1"
  echo "agent-up: T3 Code at http://$(t3_host "$name"):$(conf_get "$cfg/project.conf" T3_PORT) (first time: agent-up pair $name)"
  echo "agent-up: Tailscale (once, Windows PowerShell): tailscale serve --bg --https=$(ts_port "$cfg") $(conf_get "$cfg/project.conf" T3_PORT)"
  if [ "$(t3_connect "$cfg")" = 1 ]; then
    echo "agent-up: T3 Connect is ON (first time: agent-up shell $name; t3 connect --headless; then agent-up up $name)"
  elif [ "$(t3_connect "$cfg")" = publish ]; then
    echo "agent-up: T3 Connect: publish-only (first time: agent-up shell $name; t3 connect --headless; t3 connect link --publish-only; t3 connect publish; then agent-up up $name)"
  fi
  if ftp_on "$cfg"; then
    echo "agent-up: FTP uploads ON (tcp 21 + conntrack ftp helper; cleartext) to: $(ftp_list "$cfg" | paste -sd' ' -)"
    # A hint only: the Docker daemon's kernel may not be this one (it is, on WSL2 and native Linux).
    [ -d /sys/module/nf_conntrack_ftp ] || echo "agent-up: WARNING: nf_conntrack_ftp is not loaded in this kernel: the container's firewall will refuse to start. Run: sudo modprobe nf_conntrack_ftp"
  fi
  if [ "$(rstudio "$cfg")" = 1 ]; then
    echo "agent-up: RStudio Server at http://$(rstudio_host "$name"):$(conf_get "$cfg/project.conf" RSTUDIO_PORT) (user and password: agent-up rstudio $name)"
  fi
}
cmd_config(){
  [ $# -ge 1 ] || usage
  local cfg; cfg="$(cfg_dir "$1")"; shift
  check_files "$cfg"
  if [ "$(profile "$cfg")" = research ]; then check_research_env "$cfg"; else check_project_env "$cfg/project.env"; fi
  check_t3_connect "$cfg"
  check_research "$cfg"
  check_rstudio "$cfg"
  check_ftp "$cfg"
  prepare "$cfg"
  # Never print the owner's ambient value of a passthrough key: it is only meaningful under `op run`.
  local k
  [ ! -f "$cfg/project.env" ] || while IFS= read -r k; do [ -z "$k" ] || unset "$k"; done < <(sed -n 's/^\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' "$cfg/project.env")
  "${COMPOSE[@]}" config "$@"
}
cmd_shell(){
  [ $# -eq 1 ] || usage
  local cfg wd=/workspace; cfg="$(cfg_dir "$1")"
  if [ "$(profile "$cfg" 2>/dev/null || true)" = research ]; then wd=/research/_general; fi
  docker exec -it -u agent -w "$wd" "$(basename "$cfg")-agent-1" zsh
}
cmd_pair(){
  [ $# -eq 1 ] || usage
  local cfg name port tok; cfg="$(cfg_dir "$1")"; name="$(basename "$cfg")"
  check_files "$cfg"
  check_t3_port "$cfg"
  check_ts_port "$cfg"
  port="$(conf_get "$cfg/project.conf" T3_PORT)"
  local wait="${AGENT_UP_PAIR_WAIT:-60}" waited=0
  [[ $wait =~ ^[1-9][0-9]*$ ]] || wait=60
  [ "$(docker inspect -f '{{.State.Running}}' "$name-agent-1" 2>/dev/null)" = true ] \
    || die "could not mint a pairing token (is '$name' running? agent-up status $name)"
  until tok="$(docker exec -u agent "$name-agent-1" agent-t3 pair "$(hostname)" 2>/dev/null)"; do
    [ "$waited" -lt "$wait" ] || die "T3 server in '$name' did not answer within $wait s (agent-up status $name; docker logs $name-agent-1)"
    [ "$waited" -gt 0 ] || echo "agent-up: waiting for the T3 server in '$name'..." >&2
    sleep 2; waited=$((waited + 2))
  done
  [[ $tok =~ ^token=[A-Za-z0-9._~%-]+$ ]] || die "unexpected pairing output from the container"
  echo "T3 Code for '$name' (one-time link, valid 10 minutes):"
  echo "  http://$(t3_host "$name"):$port/pair#$tok"
  echo "Its own browser origin keeps this project's T3 session apart from other projects'."
  echo "If your browser cannot open it, use: http://localhost:$port/pair#$tok"
  echo "In the T3 apps (Add environment -> host + pairing code):"
  echo "  desktop app on this PC: http://localhost:$port"
  echo "  phone (Tailscale on):   $(ts_url "$cfg")"
  echo "  pairing code: ${tok#token=}"
  [ -n "$(tailscale_host)" ] || echo "  (set TAILSCALE_HOST in $CFG_ROOT/agent-up.conf to your machine.tailnet.ts.net name; see the README, Phone and desktop apps (Tailscale))"
}
cmd_rstudio(){
  [ $# -eq 1 ] || usage
  local cfg name port pw; cfg="$(cfg_dir "$1")"; name="$(basename "$cfg")"
  check_files "$cfg"
  check_rstudio "$cfg"
  [ "$(rstudio "$cfg")" = 1 ] || die "RStudio Server is off for '$name': set RSTUDIO=1 in $cfg/project.conf, then agent-up up $name"
  pw="$cfg/.generated/rstudio-password"
  [ -s "$pw" ] || die "no password yet for '$name': run agent-up up $name first"
  port="$(conf_get "$cfg/project.conf" RSTUDIO_PORT)"
  echo "RStudio Server for '$name':"
  echo "  http://$(rstudio_host "$name"):$port"
  echo "  user:     agent"
  echo "  password: $(cat "$pw")"
  echo "Its own browser origin keeps this project's RStudio sign-in apart from other projects' (and from T3)."
  echo "If your browser cannot open it, use: http://localhost:$port"
}
is_running(){ [ "$(docker inspect -f '{{.State.Running}}' "$1" 2>/dev/null)" = true ]; }   # $1 container
busy_scan(){ # $1 container -> BUSY:/IDLE: lines; exit 1 if anything is busy, 0 otherwise (also when not running)
  is_running "$1" || return 0
  local ps='pid=,ppid=,etimes=,cputimes=,comm=,args=' s1 s2 out
  s1="$(docker exec "$1" ps -eo "$ps" 2>/dev/null || true)"
  # Fail closed: this gates restarts, so a container we cannot look into counts as busy.
  [ -n "$s1" ] || { echo "BUSY: cannot inspect processes (docker exec ps failed)"; return 1; }
  sleep "${AGENT_UP_BUSY_SAMPLE:-5}"
  s2="$(docker exec "$1" ps -eo "$ps" 2>/dev/null || true)"
  out="$(awk '
    function args(  a, i) { a = ""; for (i = 6; i <= NF; i++) a = a (i > 6 ? " " : "") $i; return a }
    NR == FNR { cpu0[$1] = $4; next }
    { pid[FNR] = $1; ppid[FNR] = $2; et[FNR] = $3; cpu[FNR] = $4; comm[FNR] = $5; arg[FNR] = args(); kids[$2]++; n = FNR }
    END {
      for (i = 1; i <= n; i++) {
        grew = (pid[i] in cpu0) && cpu[i] - cpu0[pid[i]] >= 1
        if (comm[i] == "Rscript") {
          a = arg[i]; sub(/^[^ ]*[ ]*/, "", a)
          printf "BUSY: Rscript %s (running %dh%dm)\n", substr(a, 1, 80), et[i] / 3600, (et[i] % 3600) / 60
        } else if (comm[i] == "R" || comm[i] == "rsession") {
          if (grew) printf "BUSY: %s using CPU (pid %s)\n", comm[i], pid[i]
          else printf "IDLE: idle R session (%s)\n", comm[i]
        } else if (comm[i] == "claude" || comm[i] == "codex") {
          if (grew || kids[pid[i]] > 0) printf "BUSY: agent may be mid-task (%s, pid %s)\n", comm[i], pid[i]
          else printf "IDLE: agent idle (%s)\n", comm[i]
        }
      }
    }' <(printf '%s\n' "$s1") <(printf '%s\n' "$s2"))"
  [ -z "$out" ] || printf '%s\n' "$out"
  ! grep -q '^BUSY:' <<<"$out"
}
project_names(){ # every project name, alphabetical, the project living in this clone last
  local root conf d pd names=() self=""
  root="$(cd "$HERE/.." && pwd -P)"
  for conf in "$CFG_ROOT"/*/project.conf; do
    [ -f "$conf" ] || continue
    d="$(basename "$(dirname "$conf")")"
    pd="$(conf_get "$conf" PROJECT_DIR)"
    pd="$(cd "$pd" 2>/dev/null && pwd -P || printf '%s' "$pd")"
    if [ "$pd" = "$root" ]; then self="$d"; else names+=("$d"); fi
  done
  [ "${#names[@]}" -eq 0 ] || printf '%s\n' "${names[@]}" | LC_ALL=C sort
  [ -z "$self" ] || printf '%s\n' "$self"
}
cmd_busy(){
  [ $# -ge 1 ] || usage
  local names=() n tmp c cfg busy=() rc=0
  if [ "$1" = --all ]; then
    [ $# -eq 1 ] || usage
    mapfile -t names < <(project_names)
    [ "${#names[@]}" -gt 0 ] || die "no projects in $CFG_ROOT"
  elif [ $# -eq 1 ]; then
    cfg="$(cfg_dir "$1")"
    busy_scan "$(basename "$cfg")-agent-1" || rc=1
    return "$rc"
  else
    for n in "$@"; do cfg="$(cfg_dir "$n")"; names+=("$(basename "$cfg")"); done
  fi
  tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
  for n in "${names[@]}"; do   # one background scan per running container: one sample interval in total
    c="$n-agent-1"
    if is_running "$c"; then ( busy_scan "$c" > "$tmp/$n.out" || echo 1 > "$tmp/$n.busy" ) &
    else echo "not running" > "$tmp/$n.out"; fi
  done
  wait
  for n in "${names[@]}"; do
    echo "== $n"; cat "$tmp/$n.out"
    [ ! -f "$tmp/$n.busy" ] || busy+=("$n")
  done
  rm -rf "$tmp"; trap - EXIT
  if [ "${#busy[@]}" -gt 0 ]; then echo "Busy: $(IFS=,; echo "${busy[*]}" | sed 's/,/, /g')"; return 1; fi
  echo "Nothing busy."
}
cmd_compose(){ # $1 compose subcommand, $2 project
  local sub="$1"; shift
  [ $# -eq 1 ] || usage
  local cfg; cfg="$(cfg_dir "$1")"
  prepare "$cfg"
  "${COMPOSE[@]}" "$sub"
}
cmd_status(){
  cmd_compose ps "$@"
  # One line per agent CLI this clone knows (images/base/agent-clis/<tool>/install.conf).
  local c ver conf tool name bin; c="$(basename "$(cfg_dir "$1")")-agent-1"
  for conf in "$HERE"/../images/base/agent-clis/*/install.conf; do
    tool="$(basename "$(dirname "$conf")")"; name="$(conf_get "$conf" NAME)"; bin="$(conf_get "$conf" BIN)"
    if ver="$(docker exec -u agent "$c" "$bin" --version 2>/dev/null)" && [ -n "$ver" ]; then
      echo "$name: $ver"
    else
      echo "$name: MISSING or container not running (install log: docker logs $c | grep install-$tool)"
    fi
  done
  local cfg rd d; cfg="$(cfg_dir "$1")"
  if [ "$(profile "$cfg")" = research ]; then
    rd="$(research_dir "$cfg")"
    echo "Research downloads (on the host, $rd):"
    for d in "$rd"/*/downloads; do
      [ -d "$d" ] && [ ! -L "$d" ] || continue
      du -sh "$d" 2>/dev/null || echo "?	$d"
    done
  fi
}

# Only the owner's config defines the sandbox: ambient compose settings and interpolation variables
# must not override it (a shell variable beats --env-file in compose).
unset COMPOSE_FILE COMPOSE_PROFILES COMPOSE_PATH_SEPARATOR COMPOSE_PROJECT_NAME COMPOSE_ENV_FILES \
      PROJECT PROJECT_DIR PROFILE IMAGE SPADES_AI_DIR AGENT_MEMORY_DIR T3_PORT T3_CONNECT RESEARCH RESEARCH_DIR \
      RSTUDIO RSTUDIO_PORT TAILSCALE_HTTPS_PORT TAILSCALE_HOST FTP_HOSTS

[ $# -ge 1 ] || usage
cmd="$1"; shift
case "$cmd" in
  init)   cmd_init "$@" ;;
  up)     cmd_up "$@" ;;
  config) cmd_config "$@" ;;
  shell)  cmd_shell "$@" ;;
  pair)   cmd_pair "$@" ;;
  rstudio) cmd_rstudio "$@" ;;
  busy)   cmd_busy "$@" ;;
  status) cmd_status "$@" ;;
  stop)   cmd_compose stop "$@" ;;
  down)   cmd_compose down "$@" ;;
  *) usage ;;
esac
