#!/usr/bin/env bash
# agent-new: owner-side automation for new projects and repo wiring
# (docs/specs/2026-10-15-agent-new-design.md). Counterpart of bin/agent-up: agent-up runs the
# sandbox with a project's read-only token; agent-new runs AS THE OWNER (gh repo admin, op
# session) and automates docs/runbooks/new-project.md + machine-user-and-rulesets.md §2-4, §6.
case $- in *x*) printf 'agent-new: %s\n' "refusing to run with shell tracing on (it would print secrets)" >&2; exit 1 ;; esac
set -euo pipefail
unset OP_SERVICE_ACCOUNT_TOKEN # agent-new acts as the owner; the SA token is only ever set explicitly, per command

HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
CFG_ROOT="${AGENT_CONTAINERS_CONFIG:-$HOME/.config/agent-containers}"

say(){ printf 'agent-new: %s\n' "$*"; }
skip(){ printf 'agent-new: SKIP (done): %s\n' "$*"; }
warn(){ printf 'agent-new: WARNING: %s\n' "$*" >&2; }
die(){ printf 'agent-new: %s\n' "$*" >&2; exit 1; }
# as in agent-up
op_ready(){ # the owner's 1Password session must be signed in; one sign-in attempt, at a terminal only
  unset OP_SERVICE_ACCOUNT_TOKEN   # a project's token is never the owner's session
  command -v op >/dev/null 2>&1 || die "1Password CLI (op) not found: install it (docs/runbooks/1password-project-vault.md)"
  op whoami >/dev/null 2>&1 </dev/null && return 0
  if [ -t 0 ]; then
    printf 'agent-new: 1Password: not signed in. Signing in:\n' >&2
    eval "$(op signin)" || true
    op whoami >/dev/null 2>&1 </dev/null && return 0
  fi
  die '1Password: not signed in. Sign in first: eval "$(op signin)"'
}
usage(){
  cat >&2 <<'USAGE'
usage:
  agent-new project <folder> [--image base|gis|bio] [--public] [--no-research]
                             [--t3 publish|1|0] [--token-from <vault>] [--machine-user <user>]
  agent-new protect <owner>/<repo>... [--machine-user <user>] [--vault <op-vault>]
                             [--main-gate [--require <check>]...] [--no-working-branch]
                             [--migrate] [--retire-main-gate]
  agent-new verify  <project> | <owner>/<repo> [--vault <op-vault>] [--main-gate [--require <check>]...]
Runs AS THE OWNER. The runbooks in docs/runbooks/ remain the reference procedure.
USAGE
  exit 2
}
conf_get(){ sed -n "s/^$2=//p" "$1" | tail -n 1; }
ts_port(){ # $1 project.conf -> the Tailscale Serve HTTPS port (override or formula), validated 1-65535; as in agent-up
  local v t; v="$(conf_get "$1" TAILSCALE_HTTPS_PORT)"
  if [ -n "$v" ]; then [[ $v =~ ^[0-9]{1,9}$ ]] && v="$((10#$v))"
  else t="$(conf_get "$1" T3_PORT)"; [[ $t =~ ^[0-9]{1,9}$ ]] && v="$((8443 + 10#$t - 3774))" || v=""; fi
  [[ $v =~ ^[0-9]+$ ]] && [ "$v" -ge 1 ] && [ "$v" -le 65535 ] \
    || die "TAILSCALE_HTTPS_PORT='$v' for $1: must be a port 1-65535"
  printf '%s' "$v"
}
normalise(){ printf '%s' "$1" | tr 'A-Z' 'a-z' | sed 's/[^a-z0-9_-]/-/g; s/^[^a-z0-9]*//'; }
lc(){ printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }   # GitHub names compare case-insensitively
REPO_RE='^[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9._-]+$'
repo_arg_ok(){ [[ $1 =~ $REPO_RE ]] && [[ ${1#*/} != . && ${1#*/} != .. ]]; }
gh_read(){ # $1 what is read (for the message), then gh's arguments: prints gh's output; dies with gh's own error
  local what="$1" out rc=0 errf; shift; errf="$(mktemp)"
  out="$(gh "$@" 2>"$errf")" || rc=$?
  if [ "$rc" -ne 0 ]; then out="$(cat "$errf")${out:+ $out}"; rm -f "$errf"; die "could not read $what: $out"; fi
  rm -f "$errf"; printf '%s' "$out"
}

MAIN_GATE=0 WORK_BRANCH_ON=1 MIGRATE=0 RETIRE=0 REQUIRE_GIVEN=0 MU_TOK=""
MACHINE_USER_FLAG="" VAULT="" IMAGE="" VISIBILITY=private RESEARCH=1 T3MODE=publish TOKEN_FROM=""
REQUIRE_CHECKS=(gitleaks)

machine_user(){
  [ -n "$MACHINE_USER_FLAG" ] && { printf '%s' "$MACHINE_USER_FLAG"; return; }
  local mu=""; [ -f "$CFG_ROOT/agent-up.conf" ] && mu="$(conf_get "$CFG_ROOT/agent-up.conf" MACHINE_USER)"
  [ -n "$mu" ] || die "no machine user known: set MACHINE_USER= in $CFG_ROOT/agent-up.conf or pass --machine-user"
  printf '%s' "$mu"
}
preflight_owner(){ # prints the owner login; dies if gh is absent/anonymous/the machine user
  local who mu
  who="$(gh api user --jq .login 2>/dev/null)" || die "gh is not logged in as you (gh auth login)"
  [ -n "$who" ] || die "gh is not logged in as you (gh auth login)"
  # this runs inside $(...), where errexit is off: a failed lookup must end the run here, not return an owner
  mu="$(machine_user)" || exit 1
  [ "$(lc "$who")" != "$(lc "$mu")" ] || die "gh is logged in as the machine user ($who): agent-new runs as the OWNER"
  printf '%s' "$who"
}

project_stop_after(){ [ "${AGENT_NEW_STOP_AFTER:-}" = "$1" ] && { say "stopping after '$1' (test seam)"; exit 0; } || true; }

project_repo(){ # creates/clones $REPO into $DIR, branch main
  local fresh=1
  if [ -d "$DIR/.git" ]; then
    local org; org="$(git -C "$DIR" remote get-url origin 2>/dev/null || true)"
    case "$org" in
      https://github.com/"$REPO"|https://github.com/"$REPO".git|git@github.com:"$REPO"|git@github.com:"$REPO".git) fresh=""; skip "clone exists at $DIR" ;;
      *) die "$DIR exists but its origin ($org) is not $REPO: refusing to adopt it" ;;
    esac
  elif gh repo view "$REPO" >/dev/null 2>&1; then
    say "repo $REPO exists: cloning to $DIR"; gh repo clone "$REPO" "$DIR" >/dev/null
  else
    say "creating $REPO ($VISIBILITY) and cloning to $DIR"
    (cd "$(dirname "$DIR")" && gh repo create "$REPO" "--$VISIBILITY" --clone >/dev/null)
  fi
  # only a clone made just now is renamed: an existing one may be the agent's feature branch
  [ -z "$fresh" ] || (cd "$DIR" && { [ "$(git branch --show-current)" = main ] || git branch -m "$(git branch --show-current)" main; })
}
project_config(){
  if [ -d "$CFG_ROOT/$PROJ" ]; then skip "config exists at $CFG_ROOT/$PROJ"
  else say "agent-up init $DIR"; agent-up init "$DIR" ${IMAGE:+--image "$IMAGE"}; fi
  local out line compose="$CFG_ROOT/$PROJ/compose.yaml" ph='^[[:space:]]*image:.*REPLACE_WITH_DIGEST'   # either placeholder spelling
  if grep -Eq "$ph" "$compose"; then
    # One implementation of "replace the placeholder with a verified digest": agent-up update verifies what `latest` points to
    # (scripts/verify-image.sh: attested by publish on main, current source, newest run) and pins only that. No fallback, no prompt.
    op_ready   # update checks the owner's session too; sign in here, at the top level, where a terminal sign-in is kept
    say "pinning the image: agent-up update $PROJ"
    if ! out="$(agent-up update "$PROJ" </dev/null 2>&1)"; then
      line="$(grep '^agent-up: ' <<<"$out" | paste -sd' ' -)"
      die "could not pin the image: ${line:-$out}"
    fi
    line="$(grep -E '^[[:space:]]*image:[[:space:]]*[^[:space:]]+@sha256:[0-9a-f]{64}[[:space:]]*$' "$compose" | head -n 1)"
    { [ -n "$line" ] && ! grep -Eq "$ph" "$compose"; } || die "agent-up update $PROJ did not pin the image in $compose"
    say "pinned:${line#*image:}"
  else skip "digest already pinned"; fi
  set_conf RESEARCH "$RESEARCH"; set_conf T3_CONNECT "$T3MODE"
}
set_conf(){ # edit-in-place, never append duplicates
  local f="$CFG_ROOT/$PROJ/project.conf"
  if grep -q "^$1=" "$f"; then
    [ "$(conf_get "$f" "$1")" = "$2" ] && { skip "$1=$2"; return; }
    sed -i "s/^$1=.*/$1=$2/" "$f"
  else printf '%s=%s\n' "$1" "$2" >> "$f"; fi
  say "project.conf: $1=$2"
}
project_repo_files(){
  local cur; cur="$(git -C "$DIR" branch --show-current 2>/dev/null || true)"
  if [ "$cur" != main ]; then # also a detached HEAD (empty) or a mid-rebase checkout
    warn "$DIR is not on main (branch '${cur:-detached}'; the agent is working): skipping the repo-files step; the template files were committed on the first run"
    return
  fi
  if grep -q '@OWNER' "$DIR/.github/CODEOWNERS" 2>/dev/null; then
    say "CODEOWNERS: @OWNER -> @$OWNER"; sed -i "s/@OWNER/@$OWNER/" "$DIR/.github/CODEOWNERS"
  fi
  (cd "$DIR"
   # every git call is limited to the template paths: whatever else the agent staged is not ours to commit
   local f paths=(); for f in .github/CODEOWNERS .github/workflows/gitleaks.yml .gitignore; do
     [ ! -e "$f" ] || { git add "$f"; paths+=("$f"); }
   done
   if [ "${#paths[@]}" -eq 0 ] || git diff --cached --quiet -- "${paths[@]}" 2>/dev/null; then skip "repo files committed"
   else
     say "committing .github/ and .gitignore"
     git commit -q -m "chore: CODEOWNERS, gitleaks workflow, gitignore (agent-new)" -- "${paths[@]}"
   fi
   # a push that failed last time is retried. Push only if the remote ref is missing or HEAD has
   # commits it lacks: a fetch from the container can move origin/main AHEAD of local main, and a
   # plain "differs" test would then attempt a doomed non-fast-forward push.
   # (no HEAD = fresh empty clone = nothing to push)
   local head ahead=0; head="$(git rev-parse -q --verify HEAD 2>/dev/null)" || head=""
   if git rev-parse -q --verify refs/remotes/origin/main >/dev/null 2>&1; then
     ahead="$(git rev-list --count refs/remotes/origin/main..HEAD)"
   else ahead=1; fi
   if [ -n "$head" ] && [ "$ahead" -gt 0 ]; then
     say "pushing main (BEFORE the ruleset: gives gitleaks its first run)"
     git push -u origin main || die "push failed: fix the cause, then re-run (re-running resumes from here)"
   else skip "main pushed"; fi)
}
json_esc(){ # $1 -> REPLY: JSON string body (no quotes); dies on control characters (tokens never have them)
  [[ $1 =~ [[:cntrl:]] ]] && die "refusing to build JSON: a value contains a control character"
  REPLY="${1//\\/\\\\}"; REPLY="${REPLY//\"/\\\"}"
}
# Secrets never go in argv: the item JSON goes to `op item create -` on stdin (op >= 2.6.2). Calling this function
# with the secret as an argument is fine: bash functions and builtins start no process, so nothing shows in ps.
op_create_secret(){ # $1 vault, $2 title, $3 field id+label, $4 secret (an API Credential item with one concealed field)
  local t f s; json_esc "$2"; t="$REPLY"; json_esc "$3"; f="$REPLY"; json_esc "$4"; s="$REPLY"
  printf '{"title": "%s", "category": "API_CREDENTIAL", "fields": [{"id": "%s", "label": "%s", "type": "CONCEALED", "value": "%s"}]}\n' \
    "$t" "$f" "$f" "$s" | op item create --vault "$1" - >/dev/null || die "op item create failed for '$2' in vault $1"
  s="" REPLY=""
}
project_vault(){
  say "1Password (1password-project-vault.md):"
  op_ready
  if op vault get "$VAULT" >/dev/null 2>&1; then skip "vault $VAULT exists"
  else say "creating vault $VAULT"; op vault create "$VAULT" >/dev/null; fi
  local sa="$VAULT service account"
  if op item get "$sa" --vault Personal >/dev/null 2>&1; then skip "service account saved in Personal"
  else
    say "creating 90-day read-only service account for $VAULT"
    local tok; tok="$(op service-account create "$VAULT" --expires-in 90d --vault "$VAULT:read_items" --raw)"
    op_create_secret Personal "$sa" credential "$tok"
    tok=""
    say "scope check: the service account must see ONLY $VAULT"
    unset OP_SERVICE_ACCOUNT_TOKEN
    local seen; seen="$(OP_SERVICE_ACCOUNT_TOKEN="$(op read "op://Personal/$sa/credential")" op vault list 2>/dev/null | grep -v '^NAME\|^ID' | awk 'NF {print $NF}' | sort -u)" || true
    [ "$seen" = "$VAULT" ] || warn "scoped vault list was '$seen', expected ONLY '$VAULT' — check the service account's vault access by hand"
  fi
}
project_token(){
  if op item get github-agent --vault "$VAULT" >/dev/null 2>&1; then skip "github-agent item in $VAULT"; return; fi
  local ghtok
  if [ -n "$TOKEN_FROM" ]; then
    say "copying the machine user's PAT from $TOKEN_FROM (runbook: one classic PAT covers invited repos)"
    unset OP_SERVICE_ACCOUNT_TOKEN
    ghtok="$(op read "op://$TOKEN_FROM/github-agent/token")"
  else
    say "paste the machine user's PAT (machine-user-and-rulesets.md step 3), then ENTER:"
    read -rs ghtok; echo
  fi
  op_create_secret "$VAULT" github-agent token "$ghtok"
  ghtok=""
}
t3_port(){ # $1 project.conf -> T3_PORT as plain decimal (no leading zeros), validated
  local t; t="$(conf_get "$1" T3_PORT)"
  [[ $t =~ ^[0-9]{1,9}$ ]] && t="$((10#$t))" && [ "$t" -ge 1 ] && [ "$t" -le 65535 ] \
    || die "T3_PORT='$t' in $1: must be a port 1-65535"
  printf '%s' "$t"
}
# stdin: `tailscale serve status`; $1 T3 port. ok = >=1 block proxies to it and all are (tailnet only); public = any is not; none
ts_state(){ awk -v p="$1" '
  /^[[:space:]]*$/ { hdr=""; next }
  /^[[:space:]]*[^|[:space:]]/ { hdr=$0; next }
  /proxy/ && match($0, "(127\\.0\\.0\\.1|localhost):" p "([^0-9]|$)") { n++; if (hdr !~ /\(tailnet only\)/) bad=1 }
  END { print bad ? "public" : n ? "ok" : "none" }'; }
find_tailscale(){
  command -v tailscale.exe 2>/dev/null && return 0
  [ -x '/mnt/c/Program Files/Tailscale/tailscale.exe' ] && printf '/mnt/c/Program Files/Tailscale/tailscale.exe' && return 0
  return 1
}
project_tailscale(){
  local conf="$CFG_ROOT/$PROJ/project.conf" t3 port ts
  t3="$(t3_port "$conf")"
  port="$(ts_port "$conf")"
  local cmd="tailscale serve --bg --https=$port $t3"
  if ts="$(find_tailscale)"; then
    if [ "$("$ts" serve status | ts_state "$t3")" != none ]; then skip "tailscale serve mapping for $t3"
    else say "adding the per-project Tailscale mapping: $cmd"; "$ts" serve --bg "--https=$port" "$t3" >/dev/null; fi
    [ "$("$ts" serve status | ts_state "$t3")" = ok ] \
      || die "tailscale serve status does not show $t3 as (tailnet only): NEVER use Funnel; fix the mapping before continuing"
  else
    say "no tailscale CLI found. Run ONCE in Windows PowerShell:  $cmd"
    read -r -p "agent-new: press ENTER when done (or Ctrl-C to abort) " _
  fi
}
project_up(){
  say "starting the container (token read into this one command's environment)"
  op_ready
  local sat; sat="$(op read "op://Personal/$VAULT service account/credential")" \
    || die "could not read the service account token from op://Personal/$VAULT service account/credential (op signed in?)"
  [ -n "$sat" ] || die "the service account token at op://Personal/$VAULT service account/credential is empty"
  OP_SERVICE_ACCOUNT_TOKEN="$sat" agent-up up "$PROJ"
  sat=""
  if [ "$RESEARCH" = 1 ]; then
    if [ -d "$CFG_ROOT/research" ]; then
      say "restarting research so it mounts this project's exchange folder (no token passed)"
      env -u OP_SERVICE_ACCOUNT_TOKEN agent-up up research
    else
      warn "research is on, but there is no research container yet: run 'agent-up init --profile research', then 'agent-up up research'"
    fi
  fi
  unset OP_SERVICE_ACCOUNT_TOKEN
}
project_checklist(){
  local conf="$CFG_ROOT/$PROJ/project.conf" port host
  port="$(ts_port "$conf")"
  host="$(conf_get "$CFG_ROOT/agent-up.conf" TAILSCALE_HOST 2>/dev/null || true)"
  cat <<EOF
agent-new: DONE. Interactive logins left (once each, inside the container):
  agent-up shell $PROJ
    claude                      # subscription login, then /exit
    codex login --device-auth   # open the printed link on the host
EOF
  [ "$RESEARCH" = 1 ] && [ ! -d "$CFG_ROOT/research" ] && cat <<EOF
  research is on but has no container yet: agent-up init --profile research, then agent-up up research
EOF
  [ "$T3MODE" = publish ] && cat <<EOF
    t3 connect --headless       # approve with the SAME T3 account the apps use; 'n' to any service prompt
    t3 connect link --publish-only
    t3 connect publish
  then: agent-up up $PROJ       # (reads its own token) so the publish link takes effect
EOF
  cat <<EOF
  agent-up pair $PROJ           # pairing code for the apps
  phone (Tailscale on): https://${host:-<machine>.<tailnet>.ts.net}:$port
EOF
  [ "$MAIN_GATE" -eq 0 ] || echo "Close or approve-and-merge the verification PR in the browser."
  cat <<EOF
Allowlist extra domains in $CFG_ROOT/$PROJ/allowlist as the project needs them, then: agent-up up $PROJ
EOF
}
cmd_project(){
  [ -z "$VAULT" ] || die "project always uses vault agent-<project> (project.env from agent-up init hard-codes it); drop --vault"
  OWNER="$(preflight_owner)"
  command -v op >/dev/null || die "op (1Password CLI) not found"
  command -v docker >/dev/null || die "docker not found"
  command -v agent-up >/dev/null || die "agent-up not on PATH (symlink $HERE/agent-up)"
  local folder="$1"
  PROJ="$(normalise "$(basename "$folder")")"
  DIR="$HOME/GitHub/$(basename "$folder")"
  REPO="$OWNER/$(basename "$folder")"
  VAULT="${VAULT:-agent-$PROJ}"
  say "project $PROJ: repo $REPO, folder $DIR, vault $VAULT, machine user $(machine_user)"
  project_repo
  project_config
  project_repo_files
  project_vault
  project_token
  project_stop_after token
  cmd_protect "$REPO"
  project_tailscale
  project_up
  cmd_verify "$PROJ"
  project_checklist
}

mu_token(){ # machine-user PAT from the project vault; owner op session; ONE call's worth
  unset OP_SERVICE_ACCOUNT_TOKEN
  op read "op://$VAULT/github-agent/token"
}

mu_token_checked(){ # sets MU_TOK: the machine user's token from the vault, once per run, after checking whose it is
  local who mu
  mu="$(machine_user)"
  MU_TOK="$(mu_token)" || die "could not read op://$VAULT/github-agent/token"
  [ -n "$MU_TOK" ] || die "op://$VAULT/github-agent/token is empty"
  who="$(GH_TOKEN="$MU_TOK" gh api user --jq .login)" || die "the token in op://$VAULT/github-agent/token does not work"
  [ "$(lc "$who")" = "$(lc "$mu")" ] \
    || die "the token in op://$VAULT/github-agent/token is for '$who', not the machine user '$mu': refusing to accept invitations with it"
}

protect_collaborator(){ # $1 owner/repo: the last step of protect, so a failure before it leaves no new access
  local repo="$1" mu perm; mu="$(machine_user)"
  if gh api "repos/$repo/collaborators/$mu" >/dev/null 2>&1; then
    perm="$(gh_read "$mu's permission on $repo" api "repos/$repo/collaborators/$mu/permission" --jq .permission)"
    [ "$perm" = write ] \
      || die "$mu has '$perm' access to $repo: the account must have Write, not Admin or Maintain (Settings -> Collaborators), then re-run"
    skip "$mu is a collaborator on $repo (Write)"; return
  fi
  say "inviting $mu to $repo (machine-user-and-rulesets.md step 2.1)"
  gh api -X PUT "repos/$repo/collaborators/$mu" >/dev/null
  if [ -n "$VAULT" ]; then
    say "accepting the invitation as $mu (its token from op://$VAULT/github-agent/token, for this step only)"
    local inv lrepo; lrepo="$(lc "$repo")"
    inv="$(GH_TOKEN="$MU_TOK" gh api /user/repository_invitations \
           --jq ".[] | select((.repository.full_name | ascii_downcase) == \"$lrepo\") | .id" | head -n1)"
    [ -n "$inv" ] || die "no invitation for $repo visible to $mu (invite pending elsewhere?)"
    GH_TOKEN="$MU_TOK" gh api -X PATCH "/user/repository_invitations/$inv" >/dev/null
  else
    warn "no --vault given: accept the invitation as $mu yourself (https://github.com/$repo/invitations) or re-run with --vault agent-<project>"
  fi
}

NORM_JQ='[.target, .enforcement,
 (.bypass_actors | map("\(.actor_type):\(.actor_id):\(.bypass_mode)") | sort | join(",")),
 (.rules | map(.type) | sort | join(",")),
 ((.rules[] | select(.type=="pull_request") | .parameters |
   "pr:\(.required_approving_review_count):\(.dismiss_stale_reviews_on_push):\(.require_code_owner_review):\(.require_last_push_approval)") // "pr:-"),
 ((.rules[] | select(.type=="required_status_checks") | .parameters.required_status_checks | map(.context) | sort | join("+")) // ""),
 ((.conditions.ref_name | "refs:\(.include|sort|join(","))/\(.exclude|sort|join(","))") // "refs:-"),
 ((.rules[] | select(.type=="required_status_checks") | .parameters | "strict:\(.strict_required_status_checks_policy)") // "strict:-"),
 ((.rules[] | select(.type=="pull_request") | .parameters.allowed_merge_methods | sort | join(",")) // ""),
 ((.rules[] | select(.type=="update") | "upd:\(.parameters.update_allows_fetch_and_merge // false)") // "upd:-")
] | join("|")'

FREE_PREFIXES=(fix feature chore docs test ci refactor perf revert upstream sync experiment)
WORK_BRANCH=allen-dev

checks_sorted(){ printf '%s\n' "${REQUIRE_CHECKS[@]}" | LC_ALL=C sort -u; }
fence_excludes(){ # the branch names the fence leaves free, as a JSON list body
  local out="\"refs/heads/$WORK_BRANCH\"" p
  for p in "${FREE_PREFIXES[@]}"; do out+=", \"refs/heads/$p/**\""; done
  printf '%s' "$out"
}
ruleset_json(){ # $1 protect-main | agent-fence | agent-fence-tags
  local checks="" c
  case "$1" in
    protect-main)
      while IFS= read -r c; do checks+="{\"context\": \"$c\"},"; done < <(checks_sorted)
      cat <<JSON
{
  "name": "protect-main", "target": "branch", "enforcement": "active",
  "bypass_actors": [{"actor_id": 5, "actor_type": "RepositoryRole", "bypass_mode": "pull_request"}],
  "conditions": {"ref_name": {"include": ["~DEFAULT_BRANCH"], "exclude": []}},
  "rules": [
    {"type": "deletion"},
    {"type": "non_fast_forward"},
    {"type": "pull_request", "parameters": {
      "required_approving_review_count": 1, "dismiss_stale_reviews_on_push": true,
      "require_code_owner_review": true, "require_last_push_approval": false,
      "required_review_thread_resolution": false,
      "allowed_merge_methods": ["merge", "squash", "rebase"]}},
    {"type": "required_status_checks", "parameters": {
      "strict_required_status_checks_policy": false,
      "required_status_checks": [${checks%,}]}}
  ]
}
JSON
      ;;
    agent-fence)
      cat <<JSON
{
  "name": "agent-fence", "target": "branch", "enforcement": "active",
  "bypass_actors": [{"actor_id": 5, "actor_type": "RepositoryRole", "bypass_mode": "always"}],
  "conditions": {"ref_name": {"include": ["~ALL"], "exclude": [$(fence_excludes)]}},
  "rules": [{"type": "creation"}, {"type": "update"}, {"type": "deletion"}, {"type": "non_fast_forward"}]
}
JSON
      ;;
    agent-fence-tags)
      cat <<'JSON'
{
  "name": "agent-fence-tags", "target": "tag", "enforcement": "active",
  "bypass_actors": [{"actor_id": 5, "actor_type": "RepositoryRole", "bypass_mode": "always"}],
  "conditions": {"ref_name": {"include": ["~ALL"], "exclude": []}},
  "rules": [{"type": "creation"}, {"type": "update"}, {"type": "deletion"}]
}
JSON
      ;;
    *) die "no ruleset template named $1" ;;
  esac
}
ruleset_norm_expected(){ # $1 template name; what NORM_JQ makes of that template's live ruleset
  local ex
  case "$1" in
    protect-main)
      printf 'branch|active|RepositoryRole:5:pull_request|deletion,non_fast_forward,pull_request,required_status_checks|pr:1:true:true:false|%s|refs:~DEFAULT_BRANCH/|strict:false|merge,rebase,squash|upd:-' \
        "$(checks_sorted | paste -sd+ -)" ;;
    agent-fence)
      ex="$({ printf 'refs/heads/%s\n' "$WORK_BRANCH"; printf 'refs/heads/%s/**\n' "${FREE_PREFIXES[@]}"; } | LC_ALL=C sort | paste -sd, -)"
      printf 'branch|active|RepositoryRole:5:always|creation,deletion,non_fast_forward,update|pr:-||refs:~ALL/%s|strict:-||upd:false' "$ex" ;;
    agent-fence-tags)
      printf 'tag|active|RepositoryRole:5:always|creation,deletion,update|pr:-||refs:~ALL/|strict:-||upd:false' ;;
    *) die "no ruleset template named $1" ;;
  esac
}
ruleset_id(){ # $1 owner/repo, $2 template name: prints the id, or nothing when there is none (a ruleset named main is protect-main)
  if [ "$2" = protect-main ]; then ruleset_id_exact "$1" protect-main main; else ruleset_id_exact "$1" "$2"; fi
}
ruleset_id_exact(){ # $1 owner/repo, then one or more exact ruleset names: prints the first match's id, or nothing
  local repo="$1" out rc=0 errf sel="" n; shift; errf="$(mktemp)"
  for n in "$@"; do sel="${sel:+$sel or }.name==\"$n\""; done
  # stdout only is parsed (a stray stderr line must not become the id); stderr shown on failure
  out="$(gh api "repos/$repo/rulesets" --jq ".[] | select($sel) | .id" 2>"$errf")" || rc=$?
  [ "$rc" -eq 0 ] || die "could not list rulesets on $repo (needs admin; private repos on GitHub Free have no rulesets): $out$(cat "$errf"; rm -f "$errf")
re-running resumes from here."
  rm -f "$errf"
  head -n1 <<<"$out"
}
ensure_ruleset(){ # $1 owner/repo, $2 template name: create when absent, skip when equal, refuse when different
  local repo="$1" name="$2" id have ref=""
  [ "$name" != protect-main ] || ref="machine-user-and-rulesets.md step 4"
  id="$(ruleset_id "$repo" "$name")"
  if [ -z "$id" ]; then
    say "creating ruleset $name on $repo${ref:+ ($ref)}"
    ruleset_json "$name" | gh api -X POST "repos/$repo/rulesets" --input - >/dev/null
    return
  fi
  have="$(gh api "repos/$repo/rulesets/$id" --jq "$NORM_JQ")"
  if [ "$have" = "$(ruleset_norm_expected "$name")" ]; then
    skip "ruleset $name on $repo matches the template"
  else
    warn "live:     $have"
    warn "template: $(ruleset_norm_expected "$name")"
    die "ruleset $name on $repo differs from the template: refusing to modify it (never weaken). Edit it in the GitHub UI if the difference is intended."
  fi
}
protect_warnings(){ # $1 owner/repo
  local repo="$1"
  gh api "repos/$repo/contents/.github/CODEOWNERS" >/dev/null 2>&1 \
    || warn "$repo has no .github/CODEOWNERS: code-owner review cannot bind (copy project-template/repo/.github/, runbook step 2.2)"
  gh api "repos/$repo/contents/.github/workflows/gitleaks.yml" >/dev/null 2>&1 \
    || warn "$repo has no gitleaks workflow: the required check will never report (copy project-template/repo/.github/)"
  [ "$(gh api "repos/$repo/actions/permissions/workflow" --jq .can_approve_pull_request_reviews 2>/dev/null)" = true ] \
    && warn "$repo lets Actions approve PRs: turn it OFF (Settings -> Actions -> General, runbook step 2.3)" || true
}
protect_work_branch(){ # $1 owner/repo, $2 its default branch: create the working branch from the default branch's head unless it exists
  local repo="$1" default="$2" sha rc=0 errf err
  err="$(gh api "repos/$repo/branches/$WORK_BRANCH" 2>&1 >/dev/null)" || rc=$?
  if [ "$rc" -eq 0 ]; then
    skip "branch $WORK_BRANCH exists on $repo"
    return
  fi
  grep -q 'HTTP 404' <<<"$err" || die "could not tell whether $WORK_BRANCH exists on $repo: $err"
  rc=0; errf="$(mktemp)"
  sha="$(gh api "repos/$repo/git/ref/heads/$default" --jq .object.sha 2>"$errf")" || rc=$?
  if [ "$rc" -ne 0 ] || [ -z "$sha" ]; then
    # an empty repository answers 409 "Git Repository is empty"; anything else is gh's own error
    if grep -qi 'repository is empty' "$errf"; then
      rm -f "$errf"; die "$repo has no commits: nothing to branch $WORK_BRANCH from"
    fi
    die "could not read the head of $default on $repo: $(cat "$errf"; rm -f "$errf")"
  fi
  rm -f "$errf"
  say "creating branch $WORK_BRANCH on $repo from $default"
  gh api -X POST "repos/$repo/git/refs" -f ref="refs/heads/$WORK_BRANCH" -f sha="$sha" >/dev/null
}
protect_autodelete(){ # $1 owner/repo: merged PR branches delete themselves
  local repo="$1" v
  v="$(gh_read "the settings of $repo" api "repos/$repo" --jq .delete_branch_on_merge)"
  case "$v" in
    true)  skip "$repo already deletes merged branches" ;;
    false) say "turning on delete_branch_on_merge for $repo"
           gh api -X PATCH "repos/$repo" -F delete_branch_on_merge=true >/dev/null ;;
    *)     die "could not read delete_branch_on_merge of $repo (got: '$v')" ;;
  esac
}
confirm(){ # $1 question: 0 for yes, 1 for no, 2 when there is nobody to ask. Only a line typed at a terminal answers yes.
  local ans=""
  [ -t 0 ] || return 2
  printf '%s ' "$1" >&2
  read -r ans || true
  [[ "$ans" =~ ^[yY]$ ]]
}
OLD_FENCE_NORM='branch|active|RepositoryRole:5:always|creation,deletion,non_fast_forward,update|pr:-||refs:~ALL/refs/heads/feature/**,refs/heads/fix/**|strict:-||upd:false'
OLD_TAGS_NORM='tag|active|RepositoryRole:5:always|creation,deletion,update|pr:-||refs:~ALL/|strict:-||upd:false'
FENCE_SKIP=()   # fence rulesets this run leaves uncreated: an older hand-made one stands in their place until --migrate
free_names(){ local p out="$WORK_BRANCH"; for p in "${FREE_PREFIXES[@]}"; do out+=", $p/**"; done; printf '%s' "$out"; }
migrate_fence(){ # $1 owner/repo: the hand-made protect-fork rulesets become the agent fence (the only rulesets this tool ever renames)
  local repo="$1" pair old new oldnorm id fid have t todo=()
  FENCE_SKIP=()
  # both are checked before the first PUT: a refusal changes neither
  for pair in "protect-fork agent-fence $OLD_FENCE_NORM" "protect-fork-tags agent-fence-tags $OLD_TAGS_NORM"; do
    read -r old new oldnorm <<<"$pair"
    id="$(ruleset_id_exact "$repo" "$old")"
    [ -n "$id" ] || continue
    fid="$(ruleset_id "$repo" "$new")"
    if [ -n "$fid" ]; then
      warn "$old still exists on $repo beside $new and still limits the agent to fix/ and feature/ branches: remove it by hand (GitHub UI)"
      continue
    fi
    have="$(gh api "repos/$repo/rulesets/$id" --jq "$NORM_JQ")"
    if [ "$have" != "$oldnorm" ]; then
      [ "$MIGRATE" -eq 1 ] || continue   # not the hand-made shape, so not ours to report
      warn "live:     $have"
      warn "expected: $oldnorm"
      die "ruleset $old on $repo is not the shape --migrate renames: refusing to modify it (nothing was changed)."
    fi
    if [ "$MIGRATE" -eq 1 ]; then
      todo+=("$old $new $id")
    else
      warn "ruleset $old on $repo is the older, narrower hand-made shape (the agent is limited to fix/ and feature/): $new is not created beside it; re-run with --migrate to convert it"
      FENCE_SKIP+=("$new")
    fi
  done
  for t in ${todo[@]+"${todo[@]}"}; do
    read -r old new id <<<"$t"
    say "renaming ruleset $old on $repo to $new"
    if [ "$new" = agent-fence ]; then
      say "  free names before: fix/**, feature/**"
      say "  free names after:  $(free_names)"
    fi
    ruleset_json "$new" | gh api -X PUT "repos/$repo/rulesets/$id" --input - >/dev/null
  done
}
fence_skipped(){ local n; for n in ${FENCE_SKIP[@]+"${FENCE_SKIP[@]}"}; do [ "$n" != "$1" ] || return 0; done; return 1; }
RULE_REF_JQ='[.name, .target, (.conditions.ref_name.include | tojson), (.conditions.ref_name.exclude | tojson)] | join("\n")'
retire_main_gate(){ # $1 owner/repo: with --retire-main-gate, offer to delete protect-main and main, each found by its exact name
  local repo="$1" name id info have again rc f=()
  for name in protect-main main; do
    id="$(ruleset_id_exact "$repo" "$name")"
    if [ -z "$id" ]; then say "no ruleset named $name on $repo"; continue; fi
    info="$(gh_read "ruleset $name on $repo" api "repos/$repo/rulesets/$id" --jq "$RULE_REF_JQ")"
    mapfile -t f <<<"$info"
    if [ "${f[0]:-}" != "$name" ] || [ "${f[1]:-}" != branch ] || [ "${f[2]:-}" != '["~DEFAULT_BRANCH"]' ] || [ "${f[3]:-}" != '[]' ]; then
      warn "ruleset $name on $repo does not apply to just the default branch: leaving it alone (target ${f[1]:-?}, include ${f[2]:-?}, exclude ${f[3]:-?})"
      continue
    fi
    have="$(gh_read "ruleset $name on $repo" api "repos/$repo/rulesets/$id" --jq "$NORM_JQ")"
    say "ruleset $name on $repo: $have"
    rc=0; confirm "delete ruleset '$name' on $repo? [y/N]" || rc=$?
    case "$rc" in
      0) # the answer may have taken a while: the id must still be this ruleset's
         again="$(ruleset_id_exact "$repo" "$name")"
         [ "$again" = "$id" ] && [ "$(gh_read "ruleset $id on $repo" api "repos/$repo/rulesets/$id" --jq .name)" = "$name" ] \
           || die "ruleset $name on $repo changed while you answered: nothing was deleted; re-run"
         say "deleting ruleset $name on $repo"
         gh api -X DELETE "repos/$repo/rulesets/$id" >/dev/null ;;
      2) warn "not a terminal: $name on $repo was NOT deleted; re-run --retire-main-gate at a terminal" ;;
      *) skip "ruleset $name on $repo kept" ;;
    esac
  done
}
cmd_protect(){ # one repo, signed in to 1Password first when --vault asks for it
  if [ -n "$VAULT" ]; then op_ready; mu_token_checked; fi   # only --vault reads 1Password (the machine user's token)
  protect_repo "$1"
  MU_TOK=""
}
cmd_protect_many(){ # $@ owner/repo...: each repo in its own subshell, so a die ends only that repo
  local r rc ok=() bad=()
  if [ -n "$VAULT" ]; then op_ready; mu_token_checked; fi   # one read of the token serves every repo
  for r in "$@"; do
    # errexit is switched off around the subshell and on again inside it: a subshell run under || or if
    # would otherwise ignore errexit; stdin stays the terminal for confirm
    set +e; ( set -e; protect_repo "$r" ); rc=$?; set -e
    if [ "$rc" -eq 0 ]; then ok+=("$r"); else bad+=("$r"); fi
  done
  for r in "${ok[@]:-}"; do [ -z "$r" ] || say "protect: ok $r"; done
  for r in "${bad[@]:-}"; do [ -z "$r" ] || say "protect: FAILED $r"; done
  MU_TOK=""
  [ "${#bad[@]}" -eq 0 ]
}
REPO_INFO_JQ='[.full_name, (.permissions.admin | tostring), .owner.login, (.fork | tostring), (.parent.full_name // ""), .default_branch] | join("\n")'
read_repo_info(){ # $1 owner/repo, as the owner: sets RI_NAME (GitHub's spelling), RI_ADMIN, RI_OWNER, RI_FORK, RI_PARENT, RI_DEFAULT
  local out f=()
  out="$(gh_read "$1 on GitHub as you" api "repos/$1" --jq "$REPO_INFO_JQ")"
  mapfile -t f <<<"$out"
  RI_NAME="${f[0]:-}" RI_ADMIN="${f[1]:-}" RI_OWNER="${f[2]:-}" RI_FORK="${f[3]:-}" RI_PARENT="${f[4]:-}" RI_DEFAULT="${f[5]:-}"
  repo_arg_ok "$RI_NAME" || die "GitHub's answer for $1 names no repository (got: '$RI_NAME')"
  [[ $RI_DEFAULT =~ ^[A-Za-z0-9._/-]+$ ]] || die "could not read the default branch of $1 (got: '$RI_DEFAULT')"
}
protect_preflight(){ # $1 owner/repo as typed: the owner's own repo, with its default branch inside the fence; sets P_REPO, P_DEFAULT
  local p
  read_repo_info "$1"
  if [ "$RI_ADMIN" != true ] || [ "$(lc "$RI_OWNER")" != "$(lc "$OWNER")" ]; then
    die "agent-new protect only sets up repositories you own: $RI_NAME is owned by $RI_OWNER (signed in: $OWNER, admin: ${RI_ADMIN:-?})"
  fi
  P_REPO="$RI_NAME" P_DEFAULT="$RI_DEFAULT"
  [ "$P_DEFAULT" != "$WORK_BRANCH" ] \
    || die "the default branch $P_DEFAULT of $P_REPO would be outside the fence (the agent may write to it): make another branch the default first"
  for p in "${FREE_PREFIXES[@]}"; do
    case "$P_DEFAULT" in "$p"/*)
      die "the default branch $P_DEFAULT of $P_REPO would be outside the fence ($p/ is a name the agent may write to): make another branch the default first" ;;
    esac
  done
}
protect_notices(){ # warnings only, before the fence goes on (uses read_repo_info's RI_* values)
  local repo="$P_REPO" mine theirs shared re
  if gh api "repos/$repo/branches/gh-pages" >/dev/null 2>&1; then
    warn "$repo has a gh-pages branch: once the fence is on, pushes by GitHub Actions or Dependabot to branches outside the free names are refused"
  fi
  if gh api "repos/$repo/contents/.github/dependabot.yml" >/dev/null 2>&1; then
    warn "$repo has .github/dependabot.yml: once the fence is on, pushes by GitHub Actions or Dependabot to branches outside the free names are refused"
  fi
  [ "$RI_FORK" = true ] && [ -n "$RI_PARENT" ] || return 0
  if ! mine="$(gh api --paginate "repos/$repo/branches?per_page=100" --jq '.[].name' 2>/dev/null)" \
     || ! theirs="$(gh api --paginate "repos/$RI_PARENT/branches?per_page=100" --jq '.[].name' 2>/dev/null)"; then
    warn "could not list the branches of $repo and $RI_PARENT: not checked for upstream branches under the free names"
    return 0
  fi
  re="^($(IFS='|'; printf '%s' "${FREE_PREFIXES[*]}"))/"
  shared="$(LC_ALL=C comm -12 <(LC_ALL=C sort -u <<<"$mine") <(LC_ALL=C sort -u <<<"$theirs") | grep -E "$re" | paste -sd' ' -)" || true
  [ -z "$shared" ] \
    || warn "$repo is a fork of $RI_PARENT, and these branches from upstream have free names, so the agent can write to them: $shared"
}
protect_repo(){ # $1 owner/repo, in this order: the fence and the branch settings first, the machine user's access last
  local repo
  protect_preflight "$1"; repo="$P_REPO"
  protect_notices
  migrate_fence "$repo"
  local n
  for n in agent-fence agent-fence-tags; do
    if ! fence_skipped "$n"; then ensure_ruleset "$repo" "$n"; fi
  done
  if [ "$WORK_BRANCH_ON" -eq 1 ]; then protect_work_branch "$repo" "$P_DEFAULT"; fi
  protect_autodelete "$repo"
  if [ "$MAIN_GATE" -eq 1 ]; then
    ensure_ruleset "$repo" protect-main
    protect_warnings "$repo"
  elif [ "$RETIRE" -eq 1 ]; then
    if [ "${#FENCE_SKIP[@]}" -eq 0 ]; then retire_main_gate "$repo"   # both fence rulesets were ensured above, in this run
    else warn "the older protect-fork ruleset still stands in for the fence on $repo: not retiring the main gate (run --migrate first)"; fi
  fi
  protect_collaborator "$repo"
  say "protect: done ($repo)"
}

expect_refusal(){ # $1 label, $2 reason ERE, $3 command string (runs via RUN_IN), $4 optional: the command that undoes $3
  local label="$1" re="$2" cmd="$3" undo="${4:-}" out rc=0
  out="$(RUN_IN "$cmd" 2>&1)" || rc=$?
  if [ "$rc" -eq 0 ]; then
    printf '%s\n' "$out" >&2
    if [ -n "$undo" ]; then
      if RUN_IN "$undo" >/dev/null 2>&1; then warn "'$label' created something on $VTARGET: deleted it again ($undo)"
      else warn "'$label' created something on $VTARGET and deleting it failed: as an admin, run: $undo"; fi
    fi
    die "GATE NOT BINDING: '$label' SUCCEEDED on $VTARGET — stop, fix the ruleset before any real work"
  fi
  grep -Eqi -- "$re" <<<"$out" || {
    printf '%s\n' "$out" >&2
    die "GATE NOT BINDING: '$label' was refused, but not for the expected reason (/$re/) — investigate before trusting the gate"
  }
  say "OK (refused as expected): $label"
}

wait_checks(){ # $1 the gh pr checks command; retries only on "no checks reported"; sets CHECKS, CHECKS_RC, CHECKS_TRIES
  # CI may not have registered yet right after pr create
  local tries="${AGENT_NEW_CHECK_TRIES:-6}"
  CHECKS_TRIES=1
  while :; do
    CHECKS_RC=0; CHECKS="$(RUN_IN "$1" 2>&1)" || CHECKS_RC=$?
    [ "$CHECKS_RC" -ne 0 ] && grep -qi 'no checks reported' <<<"$CHECKS" && [ "$CHECKS_TRIES" -lt "$tries" ] || break
    CHECKS_TRIES=$((CHECKS_TRIES+1)); sleep "${AGENT_NEW_CHECK_SLEEP:-10}"
  done
}

FENCE_RE='GH013|repository rule|rule violations|protected'
FENCE_PRS=() FENCE_BRANCHES=()   # what verify_fence opened or pushed and has not removed yet; fence_cleanup removes it
fence_cleanup(){ # closes verify_fence's open PRs and deletes its remote branches; runs at the end and from the EXIT trap
  local b rc
  for b in ${FENCE_PRS[@]+"${FENCE_PRS[@]}"}; do
    RUN_IN "gh pr close $b -R $VREPO" >/dev/null 2>&1 || warn "could not close the PR from $b on $VTARGET: close it in the browser"
  done
  FENCE_PRS=()
  for b in ${FENCE_BRANCHES[@]+"${FENCE_BRANCHES[@]}"}; do
    rc=0; RUN_IN "git ls-remote --exit-code --heads origin $b" >/dev/null 2>&1 || rc=$?
    [ "$rc" -eq 2 ] || RUN_IN "git push -q origin --delete $b" >/dev/null 2>&1 \
      || warn "could not delete branch $b on $VTARGET: delete it in the browser"
  done
  FENCE_BRANCHES=()
}
fence_push(){ # $1 a branch under chore/: push HEAD there (replacing a leftover from an earlier run); it must succeed
  local out
  FENCE_BRANCHES+=("$1")
  out="$(RUN_IN "git push -f origin HEAD:refs/heads/$1" 2>&1)" \
    || die "verify: could not push $1 (the fence leaves chore/** free): $out"
}
fence_pr(){ # $1 head branch, $2 base branch: open a PR on $VREPO (one left open by an earlier run is reused); sets FENCE_PR_NUM
  local out
  FENCE_PRS+=("$1")
  out="$(RUN_IN "gh pr create -R $VREPO --base $2 --head $1 --title 'chore: verify fence' --body 'Opened by agent-new verify, which closes or merges it.'" 2>&1)" \
    || grep -q 'already exists' <<<"$out" || die "verify: could not open the PR from $1 into $2: $out"
  # gh prints the PR's URL on success and in its "already exists" message; it must be a PR on $VREPO
  FENCE_PR_NUM="$(grep -oE "https://github\.com/${VREPO//./\\.}/pull/[0-9]+" <<<"$out" | tail -n1)" || true
  FENCE_PR_NUM="${FENCE_PR_NUM##*/}"
  [[ $FENCE_PR_NUM =~ ^[0-9]+$ ]] || die "verify: no PR on $VREPO in gh's answer for $1 -> $2: $out"
}

verify_fence(){ # $1 the default branch: the machine user is refused outside the free names, and merges into the working branch
  local def="$1" out rc
  say "verifying the agent fence as the machine user (throwaway refs, removed after)"
  # one empty commit on top of origin/$def: every push below would be accepted without the fence,
  # so a refusal can only be the rule
  RUN_IN 'git commit -q --allow-empty -m "chore: verify fence"' >/dev/null
  expect_refusal "push to $def"                  "$FENCE_RE" "git push origin HEAD:$def"
  expect_refusal "branch outside the free names" "$FENCE_RE" 'git push origin HEAD:refs/heads/verify-fence-not-free' \
    'git push origin --delete refs/heads/verify-fence-not-free'
  expect_refusal "create a tag"                  "$FENCE_RE" 'git push origin HEAD:refs/tags/verify-fence-tag' \
    'git push origin --delete refs/tags/verify-fence-tag'
  fence_push chore/verify-fence
  fence_pr chore/verify-fence "$def"
  # the merge goes to the server (not gh pr merge, which refuses on its own while the PR is merely blocked),
  # so the refusal is the rule's own answer
  expect_refusal "merge a PR into $def"          "$FENCE_RE" "gh api -X PUT repos/$VREPO/pulls/$FENCE_PR_NUM/merge -f merge_method=squash"
  RUN_IN "gh pr close chore/verify-fence -R $VREPO" >/dev/null 2>&1 \
    || warn "could not close the PR from chore/verify-fence on $VTARGET: close it in the browser"
  FENCE_PRS=()
  rc=0; out="$(RUN_IN "git ls-remote --exit-code --heads origin $WORK_BRANCH" 2>&1)" || rc=$?
  case "$rc" in
    0)
      out="$(RUN_IN "git fetch -q origin +refs/heads/$WORK_BRANCH:refs/remotes/origin/$WORK_BRANCH && git checkout -q --detach origin/$WORK_BRANCH && git commit -q --allow-empty -m 'chore: verify fence ($WORK_BRANCH)'" 2>&1)" \
        || die "verify: could not make a commit on top of origin/$WORK_BRANCH: $out"
      fence_push chore/verify-fence-dev
      fence_pr chore/verify-fence-dev "$WORK_BRANCH"
      say "waiting for checks on the PR into $WORK_BRANCH"
      wait_checks "gh pr checks chore/verify-fence-dev -R $VREPO --watch"
      if [ "$CHECKS_RC" -ne 0 ]; then
        grep -qi 'no checks reported' <<<"$CHECKS" \
          || die "verify: checks are not green on the PR into $WORK_BRANCH — fix CI first, then re-run verify: $(tail -n5 <<<"$CHECKS")"
        say "no checks reported on the PR into $WORK_BRANCH after $CHECKS_TRIES tries: merging without them"
      fi
      out="$(RUN_IN "gh pr merge chore/verify-fence-dev -R $VREPO --squash --delete-branch" 2>&1)" \
        || die "verify: could not squash-merge the PR into $WORK_BRANCH: $out"
      FENCE_PRS=()
      say "OK (merged as expected): a PR into $WORK_BRANCH, squashed, its branch deleted"
      ;;
    2) say "$WORK_BRANCH is not on $VTARGET: the working-branch check was skipped" ;;
    *) die "verify: could not ask $VTARGET whether $WORK_BRANCH exists: $out" ;;
  esac
  fence_cleanup
  say "FENCE VERIFIED on $VTARGET"
}

verify_main_gate(){ # $1 the default branch: the review gate on it binds the machine user
  local def="$1"
  say "verifying the merge gate (machine-user-and-rulesets.md step 6; a throwaway PR as the machine user)"
  RUN_IN 'git commit --allow-empty -m "chore: verify ruleset"' >/dev/null
  # -f: replaces a leftover from an earlier run; the branch starts at origin/$def, so the later
  # push to $def is a fast-forward and a refusal can only be the ruleset
  RUN_IN 'git push -f -u origin verify-ruleset' >/dev/null
  local pr_out; pr_out="$(RUN_IN "gh pr create -R $VREPO --base $def --head verify-ruleset --title 'chore: verify ruleset' --body 'Opened by agent-new verify: approve-and-merge or close it.'" 2>&1)" \
    || grep -q 'already exists' <<<"$pr_out" || die "could not open the verification PR: $pr_out"
  say "waiting for required checks on the verification PR"
  wait_checks "gh pr checks verify-ruleset -R $VREPO --watch"
  if [ "$CHECKS_RC" -ne 0 ]; then
    if grep -qi 'no checks reported' <<<"$CHECKS"; then
      warn "no required check reported after $CHECKS_TRIES tries: the required-check rule stays UNTESTED (re-run verify once CI exists)"
    else
      die "required checks are not green on the verification PR — fix CI first, then re-run verify: $(tail -n5 <<<"$CHECKS")"
    fi
  fi
  printf '%s\n' "$CHECKS" | tail -n2
  expect_refusal "merge own PR"        'base branch policy|review'        "gh pr merge verify-ruleset -R $VREPO --squash"
  expect_refusal "approve own PR"      'approve your own'                 "gh pr review verify-ruleset -R $VREPO --approve"
  expect_refusal "push straight to $def" 'GH013|repository rule'         "git push origin HEAD:$def"
  expect_refusal "admin-merge own PR"  'rule violations|not.*admin'       "gh pr merge verify-ruleset -R $VREPO --squash --admin"
  say "GATE VERIFIED on $VTARGET. Approve-and-merge or close the verification PR in the browser (only your approval counts)."
}

github_repo(){ # $1 a GitHub remote URL (https, ssh or scp form) -> prints owner/repo; fails on anything else
  local r
  case "$1" in
    https://github.com/*)     r="${1#https://github.com/}" ;;
    ssh://git@github.com/*)   r="${1#ssh://git@github.com/}" ;;
    git@github.com:*)         r="${1#git@github.com:}" ;;
    *) return 1 ;;
  esac
  r="${r%/}"; r="${r%.git}"
  repo_arg_ok "$r" || return 1
  printf '%s' "$r"
}
read_origin_repo(){ # sets VREPO: the owner/repo origin points at; every gh call names it, so a fork's parent is never used
  local url
  url="$(RUN_IN 'git remote get-url origin')" || die "verify: could not read origin's URL in $VTARGET"
  VREPO="$(github_repo "$url")" || die "verify: cannot tell which GitHub repo origin is (origin: '$url'): refusing to verify"
}
read_default_branch(){ # sets VDEF: the repo's default branch, read once through RUN_IN
  VDEF="$(RUN_IN "gh repo view $VREPO --json defaultBranchRef --jq .defaultBranchRef.name")" \
    || die "could not read the default branch of $VTARGET (gh repo view failed)"
  [[ $VDEF =~ ^[A-Za-z0-9._/-]+$ ]] || die "could not read the default branch of $VTARGET (got: '$VDEF')"
}

# RUN_IN and the EXIT trap's fence_cleanup read only globals (VDIR, VTOK, VMU, VC, VWD, VREPO):
# an EXIT trap runs after this function's locals are gone
cmd_verify(){
  VTARGET="$1"
  VMU="$(machine_user)"
  if [[ "$VTARGET" == */* ]]; then
    [ -n "$VAULT" ] || die "verify <owner>/<repo> needs --vault <op-vault> (the project vault holding github-agent)"
    [[ $VTARGET =~ $REPO_RE ]] || die "verify wants <owner>/<repo> (got: $VTARGET)"
    # trap value frozen at set time: an EXIT trap outlives this function's locals,
    # so deferred '$tmp' would be unbound under set -u. || true: a failing cleanup
    # must not overwrite the script's real exit status.
    local tmp; tmp="$(mktemp -d)"
    # shellcheck disable=SC2064
    trap "fence_cleanup || true; rm -rf '$tmp' || true" EXIT
    op_ready   # top level, not in mu_token: a sign-in inside $(...) would be lost
    local who; VTOK="$(mu_token)"
    who="$(GH_TOKEN="$VTOK" gh api user --jq .login)" || die "the machine-user token from op://$VAULT/github-agent/token does not work"
    [ "$who" = "$VMU" ] || die "the token in op://$VAULT/github-agent/token is for '$who', not the machine user '$VMU': refusing to verify as the wrong identity"
    # git isolated from the owner's config and credentials; the helper is single-quoted so git's
    # shell expands $GH_TOKEN at run time (the token lives in the environment only, never argv/disk)
    vgit_env(){
      export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 GIT_TERMINAL_PROMPT=0 GH_TOKEN="$VTOK" \
        GIT_CONFIG_COUNT=3 \
        GIT_CONFIG_KEY_0=credential.helper \
        GIT_CONFIG_VALUE_0='!f(){ echo username=x-access-token; echo "password=$GH_TOKEN"; }; f' \
        GIT_CONFIG_KEY_1=user.name GIT_CONFIG_VALUE_1="$VMU" \
        GIT_CONFIG_KEY_2=user.email GIT_CONFIG_VALUE_2="$VMU@users.noreply.github.com"
      # env identity outranks config: drop the owner's so the machine user is what gets recorded
      unset BASH_ENV GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL
    }
    say "cloning $VTARGET as $VMU (temp, removed after)"
    VDIR="$tmp/repo"
    (vgit_env; git clone -q "https://github.com/$VTARGET" "$VDIR") >/dev/null
    # bash -c, not -lc: the owner's login profile must not be able to re-export GH_TOKEN
    RUN_IN(){ (cd "$VDIR" && vgit_env && bash -c "$1"); }
    read_origin_repo
    [ "$VREPO" = "$VTARGET" ] || die "verify: the clone's origin is $VREPO, not $VTARGET: refusing to verify"
    read_default_branch
    RUN_IN "git fetch -q origin && git checkout -q -B verify-ruleset origin/$VDEF"
  else
    local who
    VC="${VTARGET}-agent-1" VWD=/workspace
    docker ps --format '{{.Names}}' | grep -qx "$VC" || die "container $VC is not running (agent-up up $VTARGET first)"
    RUN_IN(){ docker exec -w "$VWD" "$VC" bash -lc "$1"; }
    # a container just started by `agent-up up` may still be in agent-init, which wires git to gh last:
    # until then git has no credentials ("could not read Username"). Wait for that, not a fixed sleep.
    local iw="${AGENT_NEW_INIT_WAIT:-300}" waited=0
    [[ $iw =~ ^[1-9][0-9]*$ ]] || iw=300
    until RUN_IN 'git config --global --get credential.https://github.com.helper' >/dev/null 2>&1; do
      [ "$waited" -lt "$iw" ] || die "git in $VC has no GitHub credentials after $iw s: agent-init has not finished or gh setup-git failed (docker logs $VC | grep agent-init)"
      [ "$waited" -gt 0 ] || say "waiting for $VC to finish its first-start setup (agent-init)..."
      sleep 2; waited=$((waited + 2))
    done
    who="$(RUN_IN 'gh api user --jq .login')" || die "gh in $VC is not logged in"
    [ "$who" = "$VMU" ] || die "gh in $VC is '$who', not the machine user '$VMU': refusing to verify as the wrong identity"
    [ "$(RUN_IN 'git branch --show-current')" != verify-ruleset ] \
      || die "/workspace in $VC is on verify-ruleset (left by an older agent-new): run 'git switch main' in the container, then re-run"
    read_origin_repo
    read_default_branch
    # a temporary worktree: the owner's /workspace checkout (branch, index, files) is never touched.
    # fence_cleanup runs in the worktree, so it goes first; then the worktree (a branch checked out in it cannot be deleted).
    # shellcheck disable=SC2064 # expand now on purpose: the locals are gone when the EXIT trap runs
    trap "fence_cleanup || true; docker exec -w /workspace '$VC' git worktree remove --force /tmp/agent-new-verify 2>/dev/null || true; docker exec -w /workspace '$VC' git branch -D verify-ruleset 2>/dev/null || true" EXIT
    RUN_IN 'git worktree remove --force /tmp/agent-new-verify 2>/dev/null; git worktree prune; rm -rf /tmp/agent-new-verify' >/dev/null
    RUN_IN "git fetch -q origin && git worktree add -f -B verify-ruleset /tmp/agent-new-verify origin/$VDEF" >/dev/null
    VWD=/tmp/agent-new-verify
  fi
  if [ "$MAIN_GATE" -eq 1 ]; then verify_main_gate "$VDEF"; else verify_fence "$VDEF"; fi
}

[ $# -ge 1 ] || usage
sub="$1"; shift
args=()
while [ $# -gt 0 ]; do case "$1" in
  --machine-user) MACHINE_USER_FLAG="${2:?}"; shift 2 ;;
  --vault)        VAULT="${2:?}"; shift 2 ;;
  --image)        IMAGE="${2:?}"; shift 2 ;;
  --public)       VISIBILITY=public; shift ;;
  --no-research)  RESEARCH=0; shift ;;
  --t3)           case "${2:?}" in publish|1|0) T3MODE="$2" ;; *) die "--t3 must be publish, 1 or 0 (got: $2)" ;; esac; shift 2 ;;
  --token-from)   TOKEN_FROM="${2:?}"; shift 2 ;;
  --require)      REQUIRE_CHECKS+=("${2:?}"); REQUIRE_GIVEN=1; shift 2 ;;
  --main-gate)    MAIN_GATE=1; shift ;;
  --no-working-branch) WORK_BRANCH_ON=0; shift ;;
  --migrate)      MIGRATE=1; shift ;;
  --retire-main-gate) RETIRE=1; shift ;;
  -*)             usage ;;
  *)              args+=("$1"); shift ;;
esac; done
set -- "${args[@]:-}"
if [ "$RETIRE" -eq 1 ] && [ "$MAIN_GATE" -eq 1 ]; then
  printf 'agent-new: --retire-main-gate and --main-gate cannot be used together\n' >&2; usage
fi
[ "$REQUIRE_GIVEN" -eq 0 ] || [ "$MAIN_GATE" -eq 1 ] || warn "--require is ignored without --main-gate"

case "$sub" in
  project) [ $# -eq 1 ] && [ -n "$1" ] || usage; cmd_project "$1" ;;
  protect) [ $# -ge 1 ] || usage
           for r in "$@"; do repo_arg_ok "$r" || die "protect wants <owner>/<repo> (got: $r)"; done
           OWNER="$(preflight_owner)"
           if [ $# -gt 1 ]; then
             [ "$MAIN_GATE" -eq 0 ] || warn "--main-gate applies to every repo named: $*"
             [ "$RETIRE" -eq 0 ] || warn "--retire-main-gate applies to every repo named: $*"
           fi
           cmd_protect_many "$@" ;;
  verify)  [ $# -eq 1 ] || usage; cmd_verify "$1" ;;
  *) usage ;;
esac
