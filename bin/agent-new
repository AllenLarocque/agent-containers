#!/usr/bin/env bash
# agent-new: owner-side automation for new projects and repo wiring
# (docs/specs/2026-10-15-agent-new-design.md). Counterpart of bin/agent-up: agent-up runs the
# sandbox with a project's read-only token; agent-new runs AS THE OWNER (gh repo admin, op
# session) and automates docs/runbooks/new-project.md + machine-user-and-rulesets.md §2-4, §6.
set -euo pipefail

HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
CFG_ROOT="${AGENT_CONTAINERS_CONFIG:-$HOME/.config/agent-containers}"
DIGESTS="${AGENT_NEW_DIGESTS:-$HERE/../digests.md}"

say(){ printf 'agent-new: %s\n' "$*"; }
skip(){ printf 'agent-new: SKIP (done): %s\n' "$*"; }
warn(){ printf 'agent-new: WARNING: %s\n' "$*" >&2; }
die(){ printf 'agent-new: %s\n' "$*" >&2; exit 1; }
usage(){
  cat >&2 <<'USAGE'
usage:
  agent-new project <folder> [--image base|gis|bio] [--public] [--no-research]
                             [--t3 publish|1|0] [--token-from <vault>] [--machine-user <user>]
  agent-new protect <owner>/<repo> [--machine-user <user>] [--vault <op-vault>] [--require <check>]...
  agent-new verify  <project> | <owner>/<repo> [--vault <op-vault>]
Runs AS THE OWNER. The runbooks in docs/runbooks/ remain the reference procedure.
USAGE
  exit 2
}
conf_get(){ sed -n "s/^$2=//p" "$1" | tail -n 1; }
normalise(){ printf '%s' "$1" | tr 'A-Z' 'a-z' | sed 's/[^a-z0-9_-]/-/g; s/^[^a-z0-9]*//'; }

MACHINE_USER_FLAG="" VAULT="" IMAGE="" VISIBILITY=private RESEARCH=1 T3MODE=publish TOKEN_FROM=""
REQUIRE_CHECKS=(gitleaks)

machine_user(){
  [ -n "$MACHINE_USER_FLAG" ] && { printf '%s' "$MACHINE_USER_FLAG"; return; }
  local mu=""; [ -f "$CFG_ROOT/agent-up.conf" ] && mu="$(conf_get "$CFG_ROOT/agent-up.conf" MACHINE_USER)"
  [ -n "$mu" ] || die "no machine user known: set MACHINE_USER= in $CFG_ROOT/agent-up.conf or pass --machine-user"
  printf '%s' "$mu"
}
preflight_owner(){ # prints the owner login; dies if gh is absent/anonymous/the machine user
  local who mu
  who="$(gh api user --jq .login 2>/dev/null)" || die "gh is not logged in as you (gh auth login)"
  [ -n "$who" ] || die "gh is not logged in as you (gh auth login)"
  mu="$(machine_user)"
  [ "$who" != "$mu" ] || die "gh is logged in as the machine user ($who): agent-new runs as the OWNER"
  printf '%s' "$who"
}

project_stop_after(){ [ "${AGENT_NEW_STOP_AFTER:-}" = "$1" ] && { say "stopping after '$1' (test seam)"; exit 0; } || true; }

project_repo(){ # creates/clones $REPO into $DIR, branch main
  if [ -d "$DIR/.git" ]; then skip "clone exists at $DIR"
  elif gh repo view "$REPO" >/dev/null 2>&1; then
    say "repo $REPO exists: cloning to $DIR"; gh repo clone "$REPO" "$DIR" >/dev/null
  else
    say "creating $REPO ($VISIBILITY) and cloning to $DIR"
    (cd "$(dirname "$DIR")" && gh repo create "$REPO" "--$VISIBILITY" --clone >/dev/null)
  fi
  (cd "$DIR" && [ "$(git branch --show-current)" = main ] || git branch -m "$(git branch --show-current)" main)
}
project_config(){
  if [ -d "$CFG_ROOT/$PROJ" ]; then skip "config exists at $CFG_ROOT/$PROJ"
  else say "agent-up init $DIR"; agent-up init "$DIR" ${IMAGE:+--image "$IMAGE"}; fi
  local img digest compose="$CFG_ROOT/$PROJ/compose.yaml"
  img="$(sed -n 's/^IMAGE=//p' "$CFG_ROOT/$PROJ/project.conf" | tail -n1)"; img="spades-${img:-gis}"
  if grep -q REPLACE_WITH_DIGEST "$compose"; then
    digest="$(awk -F'|' -v i=" $img " '$2==i {gsub(/[` ]/,"",$4); d=$4} END{print d}' "$DIGESTS")"
    [ -n "$digest" ] || die "no digest for $img in $DIGESTS"
    say "pinning $img@$digest"
    sed -i "s/REPLACE_WITH_DIGEST_FROM_digests.md/${digest#sha256:}/" "$compose"
    grep -q "$digest" "$compose" || sed -i "s|@.*$|@$digest|" "$compose"
  else skip "digest already pinned"; fi
  set_conf RESEARCH "$RESEARCH"; set_conf T3_CONNECT "$T3MODE"
}
set_conf(){ # edit-in-place, never append duplicates
  local f="$CFG_ROOT/$PROJ/project.conf"
  if grep -q "^$1=" "$f"; then
    [ "$(conf_get "$f" "$1")" = "$2" ] && { skip "$1=$2"; return; }
    sed -i "s/^$1=.*/$1=$2/" "$f"
  else printf '%s=%s\n' "$1" "$2" >> "$f"; fi
  say "project.conf: $1=$2"
}
project_repo_files(){
  if grep -q '@OWNER' "$DIR/.github/CODEOWNERS" 2>/dev/null; then
    say "CODEOWNERS: @OWNER -> @$OWNER"; sed -i "s/@OWNER/@$OWNER/" "$DIR/.github/CODEOWNERS"
  fi
  (cd "$DIR"
   git add .github .gitignore 2>/dev/null || true
   if git diff --cached --quiet 2>/dev/null; then skip "repo files committed"
   else
     say "committing + pushing .github/ and .gitignore (BEFORE the ruleset: gives gitleaks its first run)"
     git commit -q -m "chore: CODEOWNERS, gitleaks workflow, gitignore (agent-new)"
     git push -u origin main
   fi)
}
project_vault(){
  say "1Password (interactive; 1password-project-vault.md). Signing in:"
  eval "$(op signin)"
  if op vault get "$VAULT" >/dev/null 2>&1; then skip "vault $VAULT exists"
  else say "creating vault $VAULT"; op vault create "$VAULT" >/dev/null; fi
  local sa="$VAULT service account"
  if op item get "$sa" --vault Personal >/dev/null 2>&1; then skip "service account saved in Personal"
  else
    say "creating 90-day read-only service account for $VAULT"
    local tok; tok="$(op service-account create "$VAULT" --expires-in 90d --vault "$VAULT:read_items" --raw)"
    op item create --vault Personal --category "API Credential" --title "$sa" "credential[concealed]=$tok" >/dev/null
    tok=""
    say "scope check: the service account must see ONLY $VAULT"
    unset OP_SERVICE_ACCOUNT_TOKEN
    local seen; seen="$(OP_SERVICE_ACCOUNT_TOKEN="$(op read "op://Personal/$sa/credential")" op vault list 2>&1)" || true
    grep -q "$VAULT" <<<"$seen" || warn "scoped vault list did not show $VAULT — check the service account by hand"
  fi
}
project_token(){
  if op item get github-agent --vault "$VAULT" >/dev/null 2>&1; then skip "github-agent item in $VAULT"; return; fi
  local ghtok
  if [ -n "$TOKEN_FROM" ]; then
    say "copying the machine user's PAT from $TOKEN_FROM (runbook: one classic PAT covers invited repos)"
    unset OP_SERVICE_ACCOUNT_TOKEN
    ghtok="$(op read "op://$TOKEN_FROM/github-agent/token")"
  else
    say "paste the machine user's PAT (machine-user-and-rulesets.md step 3), then ENTER:"
    read -rs ghtok; echo
  fi
  op item create --vault "$VAULT" --category "API Credential" --title github-agent "token[concealed]=$ghtok" >/dev/null
  ghtok=""
}
find_tailscale(){
  command -v tailscale.exe 2>/dev/null && return 0
  [ -x '/mnt/c/Program Files/Tailscale/tailscale.exe' ] && printf '/mnt/c/Program Files/Tailscale/tailscale.exe' && return 0
  return 1
}
project_tailscale(){
  local conf="$CFG_ROOT/$PROJ/project.conf" t3 port ts
  t3="$(conf_get "$conf" T3_PORT)"
  port="$(conf_get "$conf" TAILSCALE_HTTPS_PORT)"; port="${port:-$((8443 + t3 - 3774))}"
  local cmd="tailscale serve --bg --https=$port $t3"
  if ts="$(find_tailscale)"; then
    if "$ts" serve status | grep -q "127.0.0.1:$t3"; then skip "tailscale serve mapping for $t3"
    else say "adding the per-project Tailscale mapping: $cmd"; "$ts" serve --bg "--https=$port" "$t3" >/dev/null; fi
    "$ts" serve status | grep -q "(tailnet only)" \
      || die "tailscale serve status does not say (tailnet only): NEVER use Funnel; fix the mapping before continuing"
  else
    say "no tailscale CLI found. Run ONCE in Windows PowerShell:  $cmd"
    read -r -p "agent-new: press ENTER when done (or Ctrl-C to abort) " _
  fi
}
project_up(){
  say "starting the container (token read into this one command's environment)"
  unset OP_SERVICE_ACCOUNT_TOKEN
  OP_SERVICE_ACCOUNT_TOKEN="$(op read "op://Personal/$VAULT service account/credential")" agent-up up "$PROJ"
  if [ "$RESEARCH" = 1 ]; then
    OP_SERVICE_ACCOUNT_TOKEN="$(op read "op://Personal/$VAULT service account/credential")" agent-up up research
  fi
  unset OP_SERVICE_ACCOUNT_TOKEN
}
project_checklist(){
  local conf="$CFG_ROOT/$PROJ/project.conf" t3 port host
  t3="$(conf_get "$conf" T3_PORT)"; port="$(conf_get "$conf" TAILSCALE_HTTPS_PORT)"; port="${port:-$((8443 + t3 - 3774))}"
  host="$(conf_get "$CFG_ROOT/agent-up.conf" TAILSCALE_HOST 2>/dev/null || true)"
  cat <<EOF
agent-new: DONE. Interactive logins left (once each, inside the container):
  agent-up shell $PROJ
    claude                      # subscription login, then /exit
    codex login --device-auth   # open the printed link on the host
EOF
  [ "$T3MODE" = publish ] && cat <<EOF
    t3 connect --headless       # approve with the SAME T3 account the apps use; 'n' to any service prompt
    t3 connect link --publish-only
    t3 connect publish
  then: agent-up up $PROJ       # (token in env again) so the publish link takes effect
EOF
  cat <<EOF
  agent-up pair $PROJ           # pairing code for the apps
  phone (Tailscale on): https://${host:-<machine>.<tailnet>.ts.net}:$port
Close or approve-and-merge the verification PR in the browser. Allowlist extra domains in
$CFG_ROOT/$PROJ/allowlist as the project needs them, then: agent-up up $PROJ
EOF
}
cmd_project(){
  OWNER="$(preflight_owner)"
  command -v op >/dev/null || die "op (1Password CLI) not found"
  command -v docker >/dev/null || die "docker not found"
  command -v agent-up >/dev/null || die "agent-up not on PATH (symlink $HERE/agent-up)"
  local folder="$1"
  PROJ="$(normalise "$(basename "$folder")")"
  DIR="$HOME/GitHub/$(basename "$folder")"
  REPO="$OWNER/$(basename "$folder")"
  VAULT="${VAULT:-agent-$PROJ}"
  say "project $PROJ: repo $REPO, folder $DIR, vault $VAULT, machine user $(machine_user)"
  project_repo
  project_config
  project_repo_files
  project_vault
  project_token
  project_stop_after token
  cmd_protect "$REPO"
  project_tailscale
  project_up
  cmd_verify "$PROJ"
  project_checklist
}

mu_token(){ # machine-user PAT from the project vault; owner op session; ONE call's worth
  unset OP_SERVICE_ACCOUNT_TOKEN
  op read "op://$VAULT/github-agent/token"
}

protect_collaborator(){ # $1 owner/repo
  local repo="$1" mu; mu="$(machine_user)"
  if gh api "repos/$repo/collaborators/$mu" >/dev/null 2>&1; then
    skip "$mu is a collaborator on $repo"; return
  fi
  say "inviting $mu to $repo (machine-user-and-rulesets.md step 2.1)"
  gh api -X PUT "repos/$repo/collaborators/$mu" >/dev/null
  if [ -n "$VAULT" ]; then
    say "accepting the invitation as $mu (token read from op://$VAULT/github-agent/token for this step only)"
    local tok inv
    tok="$(mu_token)"
    inv="$(GH_TOKEN="$tok" gh api /user/repository_invitations \
           --jq ".[] | select(.repository.full_name==\"$repo\") | .id" | head -n1)"
    [ -n "$inv" ] || die "no invitation for $repo visible to $mu (invite pending elsewhere?)"
    GH_TOKEN="$tok" gh api -X PATCH "/user/repository_invitations/$inv" >/dev/null
    tok=""
  else
    warn "no --vault given: accept the invitation as $mu yourself (https://github.com/$repo/invitations) or re-run with --vault agent-<project>"
  fi
}

NORM_JQ='[.enforcement,
 (.bypass_actors | map("\(.actor_type):\(.actor_id):\(.bypass_mode)") | sort | join(",")),
 (.rules | map(.type) | sort | join(",")),
 ((.rules[] | select(.type=="pull_request") | .parameters |
   "pr:\(.required_approving_review_count):\(.dismiss_stale_reviews_on_push):\(.require_code_owner_review):\(.require_last_push_approval)") // "pr:-"),
 ((.rules[] | select(.type=="required_status_checks") | .parameters.required_status_checks | map(.context) | sort | join("+")) // "")
] | join("|")'

checks_sorted(){ printf '%s\n' "${REQUIRE_CHECKS[@]}" | sort -u; }
ruleset_json(){
  local checks="" c
  while IFS= read -r c; do checks+="{\"context\": \"$c\"},"; done < <(checks_sorted)
  cat <<JSON
{
  "name": "protect-main", "target": "branch", "enforcement": "active",
  "bypass_actors": [{"actor_id": 5, "actor_type": "RepositoryRole", "bypass_mode": "pull_request"}],
  "conditions": {"ref_name": {"include": ["~DEFAULT_BRANCH"], "exclude": []}},
  "rules": [
    {"type": "deletion"},
    {"type": "non_fast_forward"},
    {"type": "pull_request", "parameters": {
      "required_approving_review_count": 1, "dismiss_stale_reviews_on_push": true,
      "require_code_owner_review": true, "require_last_push_approval": true,
      "required_review_thread_resolution": false,
      "allowed_merge_methods": ["merge", "squash", "rebase"]}},
    {"type": "required_status_checks", "parameters": {
      "strict_required_status_checks_policy": false,
      "required_status_checks": [${checks%,}]}}
  ]
}
JSON
}
ruleset_norm_expected(){
  printf 'active|RepositoryRole:5:pull_request|deletion,non_fast_forward,pull_request,required_status_checks|pr:1:true:true:true|%s' \
    "$(checks_sorted | paste -sd+ -)"
}
protect_ruleset(){ # $1 owner/repo
  local repo="$1" id have
  id="$(gh api "repos/$repo/rulesets" --jq '.[] | select(.name=="protect-main") | .id' 2>/dev/null | head -n1)"
  if [ -z "$id" ]; then
    say "creating ruleset protect-main on $repo (machine-user-and-rulesets.md step 4)"
    ruleset_json | gh api -X POST "repos/$repo/rulesets" --input - >/dev/null
    return
  fi
  have="$(gh api "repos/$repo/rulesets/$id" --jq "$NORM_JQ")"
  if [ "$have" = "$(ruleset_norm_expected)" ]; then
    skip "ruleset protect-main on $repo matches the template"
  else
    warn "live:     $have"
    warn "template: $(ruleset_norm_expected)"
    die "ruleset protect-main on $repo differs from the template: refusing to modify it (never weaken). Edit it in the GitHub UI if the difference is intended."
  fi
}
protect_warnings(){ # $1 owner/repo
  local repo="$1"
  gh api "repos/$repo/contents/.github/CODEOWNERS" >/dev/null 2>&1 \
    || warn "$repo has no .github/CODEOWNERS: code-owner review cannot bind (copy project-template/repo/.github/, runbook step 2.2)"
  gh api "repos/$repo/contents/.github/workflows/gitleaks.yml" >/dev/null 2>&1 \
    || warn "$repo has no gitleaks workflow: the required check will never report (copy project-template/repo/.github/)"
  [ "$(gh api "repos/$repo/actions/permissions/workflow" --jq .can_approve_pull_request_reviews 2>/dev/null)" = true ] \
    && warn "$repo lets Actions approve PRs: turn it OFF (Settings -> Actions -> General, runbook step 2.3)" || true
}
cmd_protect(){
  protect_collaborator "$1"
  protect_ruleset "$1"
  protect_warnings "$1"
  say "protect: done ($1)"
}

expect_refusal(){ # $1 label, $2 reason ERE, $3 command string (runs via RUN_IN)
  local label="$1" re="$2" cmd="$3" out rc=0
  out="$(RUN_IN "$cmd" 2>&1)" || rc=$?
  if [ "$rc" -eq 0 ]; then
    printf '%s\n' "$out" >&2
    die "GATE NOT BINDING: '$label' SUCCEEDED on $VTARGET — stop, fix the ruleset before any real work"
  fi
  grep -Eqi -- "$re" <<<"$out" || {
    printf '%s\n' "$out" >&2
    die "GATE NOT BINDING: '$label' was refused, but not for the expected reason (/$re/) — investigate before trusting the gate"
  }
  say "OK (refused as expected): $label"
}

cmd_verify(){
  VTARGET="$1"
  if [[ "$VTARGET" == */* ]]; then
    # trap value frozen at set time: an EXIT trap outlives this function's locals,
    # so deferred '$tmp' would be unbound under set -u. || true: a failing cleanup
    # must not overwrite the script's real exit status.
    local tmp; tmp="$(mktemp -d)"; trap "rm -rf '$tmp' || true" EXIT
    say "cloning $VTARGET as $(machine_user) (temp, removed after)"
    local tok; tok="$(mu_token)"
    GH_TOKEN="$tok" gh repo clone "$VTARGET" "$tmp/repo" >/dev/null
    RUN_IN(){ (cd "$tmp/repo" && GH_TOKEN="$tok" bash -lc "$1"); }
  else
    local c="${VTARGET}-agent-1"
    docker ps --format '{{.Names}}' | grep -qx "$c" || die "container $c is not running (agent-up up $VTARGET first)"
    RUN_IN(){ docker exec -w /workspace "$c" bash -lc "$1"; }
  fi
  say "verifying the merge gate (machine-user-and-rulesets.md step 6; a throwaway PR as the machine user)"
  RUN_IN 'git switch -c verify-ruleset 2>/dev/null || git switch verify-ruleset' >/dev/null
  RUN_IN 'git commit --allow-empty -m "chore: verify ruleset"' >/dev/null
  RUN_IN 'git push -u origin verify-ruleset' >/dev/null
  local pr_out; pr_out="$(RUN_IN 'gh pr create --fill' 2>&1)" \
    || grep -q 'already exists' <<<"$pr_out" || die "could not open the verification PR: $pr_out"
  say "waiting for required checks on the verification PR"
  local checks; checks="$(RUN_IN 'gh pr checks --watch' 2>&1)" \
    || warn "no required check reported yet: the required-check rule stays UNTESTED (re-run verify once CI exists)"
  printf '%s\n' "$checks" | tail -n2
  expect_refusal "merge own PR"        'base branch policy|review'        'gh pr merge --squash'
  expect_refusal "approve own PR"      'approve your own'                 'gh pr review --approve'
  expect_refusal "push straight to main" 'GH013|repository rule'         'git push origin HEAD:main'
  expect_refusal "admin-merge own PR"  'rule violations|not.*admin'       'gh pr merge --squash --admin'
  [[ "$VTARGET" == */* ]] || RUN_IN 'git switch main' >/dev/null
  say "GATE VERIFIED on $VTARGET. Approve-and-merge or close the verification PR in the browser (only your approval counts)."
}

[ $# -ge 1 ] || usage
sub="$1"; shift
args=()
while [ $# -gt 0 ]; do case "$1" in
  --machine-user) MACHINE_USER_FLAG="${2:?}"; shift 2 ;;
  --vault)        VAULT="${2:?}"; shift 2 ;;
  --image)        IMAGE="${2:?}"; shift 2 ;;
  --public)       VISIBILITY=public; shift ;;
  --no-research)  RESEARCH=0; shift ;;
  --t3)           T3MODE="${2:?}"; shift 2 ;;
  --token-from)   TOKEN_FROM="${2:?}"; shift 2 ;;
  --require)      REQUIRE_CHECKS+=("${2:?}"); shift 2 ;;
  -*)             usage ;;
  *)              args+=("$1"); shift ;;
esac; done
set -- "${args[@]:-}"

case "$sub" in
  project) [ $# -eq 1 ] && [ -n "$1" ] || usage; cmd_project "$1" ;;
  protect) [ $# -eq 1 ] || usage; [[ "$1" == */* ]] || die "protect wants <owner>/<repo>"
           preflight_owner >/dev/null; cmd_protect "$1" ;;
  verify)  [ $# -eq 1 ] || usage; cmd_verify "$1" ;;
  *) usage ;;
esac
