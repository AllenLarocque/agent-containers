#!/usr/bin/env bash
# HOST ONLY. Pre-flight (tamper checks, launcher integrity, secrets), then (re)create the container.
#   ./up           normal start; REFUSES if any launcher file changed since adoption
#   ./up --adopt   owner only, after reviewing the launcher files: record their hashes, then start
set -euo pipefail
cd "$(dirname "$0")"
ADOPT=()
case "${1:-}" in
  --adopt) ADOPT=(--adopt) ;;
  "") ;;
  *) echo "usage: ./up [--adopt]" >&2; exit 2 ;;
esac
# Only compose.yaml defines the sandbox: ambient compose settings must not add files or profiles.
unset COMPOSE_FILE COMPOSE_PROFILES COMPOSE_PATH_SEPARATOR
PROJECT="${PROJECT:-$(basename "$PWD")}"
PROJECT="$(printf '%s' "$PROJECT" | tr 'A-Z' 'a-z' | sed 's/[^a-z0-9_-]/-/g')"
export PROJECT
# SPADES_AI_DIR comes from YOUR shell or the default, never from .env (compose would read it there).
SPADES_AI_DIR="${SPADES_AI_DIR:-$HOME/GitHub/spades.ai}"
export SPADES_AI_DIR
# resolve-secrets first: it verifies every launcher file (this one and check-digest included) before
# anything else from this folder runs.
./resolve-secrets "${ADOPT[@]}" || { echo "up: pre-flight FAILED (see above). Any container already running still has the OLD env."; exit 1; }
./check-digest compose.yaml
[ -d "$SPADES_AI_DIR" ] || { echo "up: spades.ai directory not found: $SPADES_AI_DIR (clone it there or set SPADES_AI_DIR)"; exit 1; }
docker volume inspect require-cache-shared >/dev/null 2>&1 || docker volume create require-cache-shared >/dev/null
docker compose -f compose.yaml -p "$PROJECT" up -d --force-recreate
echo "up: '$PROJECT' running. Attach: docker exec -it -u agent ${PROJECT}-agent-1 zsh   (or VS Code: Reopen in Container)"
