#!/usr/bin/env bash
# HOST ONLY. The host pre-flight for BOTH ./up and VS Code ("initializeCommand"). In order:
#   1. tamper checks on what the HOST reads or executes from this folder (the folder is the
#      agent's read-write workspace): .env, .git/config, .git/hooks, a root .devcontainer.json;
#   2. launcher integrity: compose.yaml, up, resolve-secrets, check-digest, project.env,
#      .pre-commit-config.yaml, .devcontainer/* and any non-sample .git/hooks/* must match the
#      hashes the owner adopted into ~/.config/agent-containers/<project>.launcher.sha256
#      (`./up --adopt`, or `./resolve-secrets --adopt`, records them after review);
#   3. resolves op:// references in project.env into ~/.config/agent-containers/<project>.env
#      (mode 600, outside any repo);
#   4. rewrites ./.env FROM SCRATCH with ONLY PROJECT and COMPOSE_PROJECT_NAME, so compose
#      resolves the SAME project name / env file / volumes whether started by ./up or by VS Code.
#      Nothing else may live in .env: put personal compose settings in your shell environment.
# Needs OP_SERVICE_ACCOUNT_TOKEN for THIS project's service account in the host environment
# (per-project direnv .envrc kept OUTSIDE the repo, or `op read` into the current shell at use time;
# never a global shell-profile export, never in the repo).
set -euo pipefail
cd "$(dirname "$0")"
umask 077
die(){ echo "resolve-secrets: $*" >&2; exit 1; }
ADOPT=0
case "${1:-}" in
  --adopt) ADOPT=1 ;;
  "") ;;
  *) echo "usage: resolve-secrets [--adopt]" >&2; exit 2 ;;
esac
PROJECT="${PROJECT:-$(basename "$PWD")}"
# compose project names must be lowercase [a-z0-9_-]
PROJECT="$(printf '%s' "$PROJECT" | tr 'A-Z' 'a-z' | sed 's/[^a-z0-9_-]/-/g')"
dir="$HOME/.config/agent-containers"
out="$dir/$PROJECT.env"
sums="$dir/$PROJECT.launcher.sha256"
mkdir -p "$dir"; chmod 700 "$dir"

# ---- 1. tamper checks (nothing below reads or runs anything the agent could have planted)
for f in .env .env.tmp; do
  [ -L "$f" ] && die "$f is a symlink: refusing to read or write through it (possible tampering). Inspect it, delete it, re-run."
done
if [ -e .env ]; then
  [ -f .env ] || die ".env is not a regular file (possible tampering). Inspect it, delete it, re-run."
  extra=$(grep -Ev '^(PROJECT|COMPOSE_PROJECT_NAME)=[a-z0-9_-]+$' .env || true)
  [ -z "$extra" ] || die ".env may hold ONLY PROJECT and COMPOSE_PROJECT_NAME, but it has:
$(printf '%s\n' "$extra" | sed 's/^/    .env: /')
  It is regenerated on every run, so extra keys are possible tampering (compose would read them,
  e.g. SPADES_AI_DIR or COMPOSE_FILE). Review, delete .env, re-run. Personal compose settings
  belong in your shell environment, not in .env."
fi
[ -e .devcontainer.json ] && die "a root .devcontainer.json exists (VS Code could pick it instead of .devcontainer/devcontainer.json). Review and delete it."
{ [ -d .git ] && [ ! -L .git ]; } || die "this folder must be a git clone with a real .git directory (not a symlink, file or worktree)."
[ -L .git/hooks ] && die ".git/hooks is a symlink (possible tampering)."
mkdir -p .git/hooks   # compose overlays it read-only into the container
command -v git >/dev/null || die "git is required on the host to check .git/config"
# Repo-local git config keys that make HOST-side git run a program. --includes follows include.path.
cfgkeys=$(git config --file .git/config --includes --list --name-only 2>/dev/null) || die "cannot parse .git/config"
DANGER='^(core\.(fsmonitor|hookspath|sshcommand|pager|editor|askpass|gitproxy)|sequence\.editor|diff\.external|(diff|filter|merge)\..+\.(textconv|command|clean|smudge|process|driver)|credential\..*|gpg\..*program|(remote\..+\.)?(uploadpack|receivepack)|include\.path|includeif\..+\.path|alias\..+)$'
bad=$(grep -iE "$DANGER" <<<"$cfgkeys" | tr 'A-Z' 'a-z' | sort -u || true)
[ -z "$bad" ] || die ".git/config sets key(s) that run programs in HOST-side git:
$(printf '%s\n' "$bad" | sed 's/^/    /')
  Possible tampering. Review and remove them (git config --unset <key>), then re-run."

# ---- 2. launcher integrity
launcher_files(){
  printf '%s\n' compose.yaml up resolve-secrets check-digest project.env .pre-commit-config.yaml
  find .devcontainer -mindepth 1 2>/dev/null | LC_ALL=C sort
  find .git/hooks -mindepth 1 ! -name '*.sample' | LC_ALL=C sort
}
mapfile -t LF < <(launcher_files)
cur=""
for f in "${LF[@]}"; do
  { [ -f "$f" ] && [ ! -L "$f" ]; } || die "launcher file missing or not a regular file: $f"
  cur+="$(sha256sum -- "$f")"$'\n'
done
if [ "$ADOPT" = 1 ]; then
  tmp=$(mktemp "$dir/.launcher.XXXXXX")
  printf '%s' "$cur" > "$tmp"; chmod 600 "$tmp"; mv -f "$tmp" "$sums"
  echo "resolve-secrets: ADOPTED ${#LF[@]} launcher file(s) into $sums:"
  printf '    %s\n' "${LF[@]}"
elif [ ! -f "$sums" ]; then
  die "launcher not adopted for '$PROJECT' ($sums missing): review, then run ./up --adopt
  Review compose.yaml, up, resolve-secrets, check-digest, project.env, .pre-commit-config.yaml,
  .devcontainer/ and any .git/hooks/* (e.g. diff against agent-containers/project-template), then run:
    ./up --adopt"
elif [ "$cur" != "$(cat "$sums")"$'\n' ]; then
  changed=$(diff -u <(cat "$sums") <(printf '%s' "$cur") | sed -n 's/^[-+][0-9a-f]\{64\}  //p' | LC_ALL=C sort -u | tr '\n' ' ' || true)
  die "launcher files changed since adoption: ${changed}(re-adopt with ./up --adopt ONLY if intended)
  These files run on the HOST (with your 1Password token) or define the sandbox. Something changed
  them: the agent before the read-only overlay, or an edit outside the container. Review the change
  (git diff / git log), and ONLY if it is intended, re-adopt:
    ./up --adopt"
fi

# ---- 3. secrets
[ -n "${OP_SERVICE_ACCOUNT_TOKEN:-}" ] || die "OP_SERVICE_ACCOUNT_TOKEN not set (see docs/runbooks/1password-project-vault.md)"
# The firewall's project allowlist lives HERE, outside the repo, because the repo is the agent-writable
# workspace (an agent could otherwise allowlist its own exfiltration host for the next start).
allow="$dir/$PROJECT.allowlist"
[ -f "$allow" ] || die "project allowlist not found: $allow
  Create it (owner-maintained; the repo's allowlist.txt is only a seed and edits there have no effect):
    cp allowlist.txt \"\$HOME/.config/agent-containers/$PROJECT.allowlist\""
rm -f "$out"   # never inherit a wider mode from an earlier file
op inject --force -i project.env -o "$out"
chmod 600 "$out"

# ---- 4. .env from scratch: identity keys only, via a fresh temp file in the same dir
tmp=$(mktemp ./.env.XXXXXXXX)
[ -L "$tmp" ] && die "temp file $tmp is a symlink (possible tampering)"
printf 'PROJECT=%s\nCOMPOSE_PROJECT_NAME=%s\n' "$PROJECT" "$PROJECT" > "$tmp"
mv -f "$tmp" .env
echo "resolve-secrets: wrote $(grep -c = "$out") value(s) to $out"
