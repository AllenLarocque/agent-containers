#!/usr/bin/env bash
# HOST ONLY. Resolves op:// references in project.env into ~/.config/agent-containers/<project>.env
# (mode 600, outside any repo), and records the project identity in ./.env (gitignored) so that
# compose resolves the SAME project name / env file / volume whether started by ./up or by VS Code.
# Needs OP_SERVICE_ACCOUNT_TOKEN for THIS project's service account in the host environment
# (per-project direnv .envrc kept OUTSIDE the repo, or `op read` into the current shell at use time;
# never a global shell-profile export, never in the repo).
set -euo pipefail
cd "$(dirname "$0")"
PROJECT="${PROJECT:-$(basename "$PWD")}"
# compose project names must be lowercase [a-z0-9_-]
PROJECT="$(printf '%s' "$PROJECT" | tr 'A-Z' 'a-z' | sed 's/[^a-z0-9_-]/-/g')"
dir="$HOME/.config/agent-containers"
out="$dir/$PROJECT.env"
umask 077
mkdir -p -m 700 "$dir"; chmod 700 "$dir"
[ -n "${OP_SERVICE_ACCOUNT_TOKEN:-}" ] || { echo "resolve-secrets: OP_SERVICE_ACCOUNT_TOKEN not set (see docs/runbooks/1password-project-vault.md)"; exit 1; }
# The firewall's project allowlist lives HERE, outside the repo, because the repo is the agent-writable
# workspace (an agent could otherwise allowlist its own exfiltration host for the next start).
allow="$dir/$PROJECT.allowlist"
[ -f "$allow" ] || { echo "resolve-secrets: project allowlist not found: $allow"
  echo "  Create it (owner-maintained; the repo's allowlist.txt is only a seed and edits there have no effect):"
  echo "    cp allowlist.txt \"\$HOME/.config/agent-containers/$PROJECT.allowlist\""; exit 1; }
rm -f "$out"   # never inherit a wider mode from an earlier file
op inject --force -i project.env -o "$out"
chmod 600 "$out"
# project identity for compose (keep any other keys the user put in .env)
{ [ -f .env ] && grep -Ev '^(PROJECT|COMPOSE_PROJECT_NAME)=' .env || true
  echo "PROJECT=$PROJECT"; echo "COMPOSE_PROJECT_NAME=$PROJECT"; } > .env.tmp && mv .env.tmp .env
echo "resolve-secrets: wrote $(grep -c = "$out") value(s) to $out"
