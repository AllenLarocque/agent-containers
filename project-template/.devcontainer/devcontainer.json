{
  // VS Code "Reopen in Container": runs ./resolve-secrets on the host first (writes ./.env with PROJECT and
  // COMPOSE_PROJECT_NAME, which the Dev Containers tooling reads to name the compose project, same as ./up).
  // Needs OP_SERVICE_ACCOUNT_TOKEN in the environment VS Code was launched from (see README).
  "name": "${localWorkspaceFolderBasename}",
  "initializeCommand": "./resolve-secrets",
  "dockerComposeFile": ["../compose.yaml"],
  "service": "agent",
  "workspaceFolder": "/workspace",
  "remoteUser": "agent",
  "overrideCommand": false,
  "shutdownAction": "none",
  "customizations": { "vscode": { "extensions": ["anthropic.claude-code", "eamodio.gitlens"] } }
}
