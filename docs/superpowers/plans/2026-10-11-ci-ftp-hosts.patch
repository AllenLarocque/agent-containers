+      - name: Firewall with FTP hosts (tcp 21 + conntrack ftp helper; snapshot, on/off/re-run, live passive listing)
+        if: always() && steps.mode.outputs.mode == 'full'
+        run: |
+          test -d /sys/module/nf_conntrack_ftp || { echo "::error title=FTP firewall::nf_conntrack_ftp is not loaded on the runner"; exit 1; }
+          # The live check's server (EBI's public anonymous FTP), proven listable in passive mode FROM THE
+          # RUNNER first, so a failure inside the container is the firewall, not EBI.
+          FTP_HOST=ftp.ebi.ac.uk; FTP_URL=ftp://ftp.ebi.ac.uk/pub/
+          curl -q -sS --connect-timeout 10 --max-time 60 --list-only "$FTP_URL" -o /tmp/ftp-runner.list
+          echo "runner lists $FTP_URL ($(wc -l < /tmp/ftp-runner.list) entries)"
+          # (a) agent-up's exact mount: the owner's host list, read-only -> exact filter + raw snapshot.
+          printf '%s\n' "$FTP_HOST" > /tmp/ftp-hosts
+          printf 'www.python.org' > /tmp/40-extra.txt
+          printf 'www.r-project.org\r\ncran.r-project.org  # inline comment\n\n# comment only\nwww.mozilla.org' > /tmp/50-project.txt
+          docker network create ftpnet
+          docker run -d --name fwftp --network ftpnet --cap-add NET_ADMIN --cap-add NET_RAW \
+            -v /tmp/ftp-hosts:/etc/firewall/ftp-hosts:ro \
+            -v /tmp/40-extra.txt:/etc/firewall/allowlist.d/40-extra.txt:ro \
+            -v /tmp/50-project.txt:/etc/firewall/allowlist.d/50-project.txt:ro \
+            -v "$PWD/tests:/tests:ro" spades-base:ci sleep infinity
+          # (b) no mount: test-ftp.sh writes the host list itself to turn FTP on and off between runs.
+          docker run -d --name fwftp2 --network ftpnet --cap-add NET_ADMIN --cap-add NET_RAW \
+            -v "$PWD/tests:/tests:ro" spades-base:ci sleep infinity
+          UP=$(docker exec fwftp awk '/^nameserver/{print $2; exit}' /etc/resolv.conf); echo "original resolver: $UP"
+          rc=0   # run every suite, fail at the end; FAIL lines become annotations (logs are not readable remotely)
+          run(){ "$@" 2>&1 | tee -a /tmp/ftp.log; return "${PIPESTATUS[0]}"; }
+          run docker exec fwftp sudo /usr/local/bin/init-firewall.sh || rc=1
+          run docker exec fwftp sudo /usr/local/bin/init-firewall.sh || rc=1   # idempotent re-run
+          grep -q "^FTP: ON (hosts $FTP_HOST; tcp 21 + conntrack ftp helper)" /tmp/ftp.log || { echo "FAIL: no 'FTP: ON' line in the firewall log" | tee -a /tmp/ftp.log; rc=1; }
+          run docker exec -u root -e EXPECT_UPSTREAM="$UP" -e EXPECT_FTP=1 fwftp bash /tests/firewall/test-firewall.sh || rc=1
+          run docker exec -u agent -e EXPECT_UPSTREAM="$UP" -e REQUIRE_DOCKER_DNS=1 fwftp bash /tests/firewall/test-agent-egress.sh || rc=1
+          if docker exec -u agent fwftp curl -q -sS --connect-timeout 10 --max-time 60 --list-only "$FTP_URL" > /tmp/ftp-agent.list && [ -s /tmp/ftp-agent.list ]; then
+            echo "OK:   agent lists $FTP_URL through the read-only mount" | tee -a /tmp/ftp.log
+          else echo "FAIL: agent cannot list $FTP_URL through the read-only mount" | tee -a /tmp/ftp.log; rc=1; fi
+          run docker exec -u root -e FTP_HOST="$FTP_HOST" -e FTP_URL="$FTP_URL" -e ANNOTATE=1 fwftp2 bash /tests/firewall/test-ftp.sh || rc=1
+          if [ "$rc" -ne 0 ]; then
+            msg=$(grep -E '^(FAIL|ERROR|        )' /tmp/ftp.log | head -n 60 | sed 's/%/%25/g; s/\r//g' | awk '{printf "%s%%0A", $0}')
+            echo "::error title=FTP firewall tests::$msg"
+          fi
+          docker rm -f fwftp fwftp2
+          docker network rm ftpnet
+          exit $rc
