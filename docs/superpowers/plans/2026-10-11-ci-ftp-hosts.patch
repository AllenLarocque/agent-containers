+      # FTP uploads (spec §13.4) need the kernel's FTP conntrack helper, and a container cannot load a
+      # module: load it on the runner (as owners do on a native Linux host; WSL2 kernels have it built in)
+      # BEFORE any step that starts a firewall with FTP hosts (the FTP step and the launcher test).
+      - name: Load the FTP conntrack helper on the runner (nf_conntrack_ftp)
+        if: steps.mode.outputs.mode == 'full'
+        run: |
+          sudo modprobe nf_conntrack_ftp
+          test -d /sys/module/nf_conntrack_ftp || { echo "::error title=nf_conntrack_ftp::not loaded after modprobe"; exit 1; }
+          echo "nf_conntrack_ftp loaded: $(cat /sys/module/nf_conntrack_ftp/parameters/ports 2>/dev/null || echo '?') (ports)"
       - name: Image size report (annotation)
