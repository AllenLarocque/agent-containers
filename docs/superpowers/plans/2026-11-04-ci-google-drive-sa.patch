         run: bash tests/launcher/test-agent-new.sh
       - name: Acceptance (setupProject behind firewall, plain Rscript)
         if: steps.mode.outputs.mode == 'full'
+        env:
+          # Optional: a Drive service-account key + a file shared ONLY with it. Absent -> no mount, no env.
