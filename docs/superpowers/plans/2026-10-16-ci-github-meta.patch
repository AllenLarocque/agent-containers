           echo "nf_conntrack_ftp loaded: $(cat /sys/module/nf_conntrack_ftp/parameters/ports 2>/dev/null || echo '?') (ports)"
+      # ONE authenticated api.github.com/meta fetch for the whole job. Dozens of firewalled containers
+      # each fetching it unauthenticated (60/hour per runner IP) ran into the rate limit mid-run.
+      # init-firewall.sh takes a host-mounted /etc/firewall/github-meta.json instead of fetching (CI
+      # only; agent-up never mounts it). The default-bridge step (fw) and the fetch-failure tests keep
+      # the LIVE fetch, so the production path stays tested end to end.
+      - name: GitHub meta fixture for the firewalled test containers (one authenticated fetch)
+        if: always() && steps.mode.outputs.mode == 'full'
+        env:
+          GH_API_TOKEN: ${{ github.token }}
+        run: |
+          set -o pipefail
+          f="$RUNNER_TEMP/github-meta.json"
+          curl -q -fsS --retry 3 --connect-timeout 10 --max-time 60 \
+            -H "Authorization: Bearer $GH_API_TOKEN" -H 'Accept: application/vnd.github+json' \
+            -o "$f.tmp" https://api.github.com/meta
+          jq -e '.web and .api and .git' "$f.tmp" >/dev/null || { echo "::error title=GitHub meta fixture::api.github.com/meta lacks web/api/git"; exit 1; }
+          mv "$f.tmp" "$f"; chmod 644 "$f"
+          echo "GitHub meta fixture: $(jq '(.web + .api + .git) | length' "$f") ranges (web+api+git)"
+          echo "GH_META_FIXTURE=$f" >> "$GITHUB_ENV"
